{
  "name": "@prized/electric-agents",
  "version": "0.1.0",
  "description": "Prized Sandboxes for Electric Agents: a sandbox profile that runs each entity's tools in a Firecracker microVM, paused with its memory between wakes and reattached by key from any runner.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "electric",
    "electric-agents",
    "sandbox",
    "prized",
    "microvm",
    "agents"
  ],
  "author": "Prized <team@prized.dev>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/prized-dev/integrations/tree/main/electric-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prized-dev/integrations.git",
    "directory": "electric-agents"
  },
  "bugs": {
    "url": "https://github.com/prized-dev/integrations/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/client.test.ts test/sandbox.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@prized/sdk": "^0.1.2"
  },
  "peerDependencies": {
    "@electric-ax/agents-runtime": ">=0.6.0 <1.0.0"
  },
  "devDependencies": {
    "@electric-ax/agents-runtime": "^0.6.3",
    "@types/node": "^24.10.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
