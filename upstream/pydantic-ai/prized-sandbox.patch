+        'insufficient_balance',
+        'workspace_held',
+        'workspace_closing',
+        'template_not_found',
+        'template_inactive',
+        'invalid_resources',
+        'unknown_field',
+        'bad_request',
+        'invalid_max_runtime',
+        'sandbox_quota_exceeded',
+        'parent_not_forkable',
