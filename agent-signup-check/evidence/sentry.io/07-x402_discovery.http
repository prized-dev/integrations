        :root {
          --loop: 2350ms;
        }

        g[data-index] path {
          stroke-dasharray: 1150;
          stroke-dashoffset: 1150;
          animation-duration: var(--loop);
          animation-iteration-count: infinite;
          animation-fill-mode: both;
