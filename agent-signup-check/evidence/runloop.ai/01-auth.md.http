<style>
  .code-block { 
    position: relative; 
    background: #0a0a0a; 
    border-radius: 12px; 
    overflow: hidden; 
    margin: 16px 0;
  }
  .code-header { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 10px 14px; 
    border-bottom: 1px solid rgba(255,255,255,0.06); 
  }
  .code-lang { 
    font-family: 'JetBrains Mono', monospace; 
    font-size: 11px; 
    color: rgba(255,255,255,0.5); 
    letter-spacing: 0.1em; 
  }
  .code-copy { 
    background: transparent; 
    border: 1px solid rgba(255,255,255,0.15); 
    color: rgba(255,255,255,0.7); 
    font-size: 12px; 
    padding: 4px 10px; 
    border-radius: 6px; 
    cursor: pointer; 
    font-family: inherit; 
  }
  .code-copy:hover { 
    background: rgba(255,255,255,0.08); 
    color: white; 
  }
  .code-copy.copied { 
    background: #16A34A; 
    color: white; 
    border-color: #16A34A; 
  }
  .code-block pre { 
    margin: 0 !important; 
    padding: 14px 16px !important; 
    background: transparent !important; 
    font-size: 13px; 
    line-height: 1.6; 
  }
  .code-block code { 
    font-family: 'JetBrains Mono', monospace !important; 
    background: transparent !important;
  }
</style>

<style>
  /* ==================================== TRACKPAD STYLE  ====================================*/
body {
  --sb-track-color: #e9ecea;
  --sb-thumb-color: #0e694e;
  --sb-size: 8px;
}

body::-webkit-scrollbar {
  width: var(--sb-size)
}

body::-webkit-scrollbar-track {
  background: var(--sb-track-color);
  border-radius: 10px;
}

body::-webkit-scrollbar-thumb {
  background: var(--sb-thumb-color);
  border-radius: 10px;
  
}

@supports not selector(::-webkit-scrollbar) {
  body {
    scrollbar-color: var(--sb-thumb-color)
                     var(--sb-track-color);
  }
}
  
  
body.dark-mode{
  --sb-track-color: #141515;
  --sb-thumb-color: #3c3f3f;
}
  
.w-code-block {
  border-radius: 1rem;
  }
  
/* ==================================== TITLE HIGHLIGHTS  ====================================*/
.title-highlight{
  position:relative;
  display:inline-block;
  padding: 10px 18px;
  margin-left: -10px;
  margin-right: -10px;

  /* tokens */
  --dot-size:8px;          /* dot diameter */
  --dot-offset:4px;        /* inset from each edge */
  --border-width:1px;

  /* light colors */
  --border-color:rgba(14,105,78,0.4);
  --dot-stroke:rgba(14,105,78,0.4);
  --dot-fill:#fff;

  /* TEXT COLOR (light): solid #0E694E */
  background:none !important;
  -webkit-background-clip: initial !important;
  background-clip: initial !important;
  -webkit-text-fill-color: initial !important;
  color:#0E694E !important;
}

/* border centered on dot radius */
.title-highlight::before{
  content:"";
  position:absolute;
  inset:calc(var(--dot-offset) + var(--dot-size)/2 - var(--border-width)/2);
  border:var(--border-width) solid var(--border-color);
  pointer-events:none;
  box-sizing:border-box;
}

/* four corner dots (fill + 1px stroke) */
.title-highlight::after{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle,
      var(--dot-fill) 0,
      var(--dot-fill) calc(var(--dot-size)/2 - 1px),
      var(--dot-stroke) calc(var(--dot-size)/2 - 1px),
      var(--dot-stroke) calc(var(--dot-size)/2),
      transparent calc(var(--dot-size)/2)
    ),
    radial-gradient(circle,
      var(--dot-fill) 0,
      var(--dot-fill) calc(var(--dot-size)/2 - 1px),
      var(--dot-stroke) calc(var(--dot-size)/2 - 1px),
      var(--dot-stroke) calc(var(--dot-size)/2),
      transparent calc(var(--dot-size)/2)
    ),
    radial-gradient(circle,
      var(--dot-fill) 0,
      var(--dot-fill) calc(var(--dot-size)/2 - 1px),
      var(--dot-stroke) calc(var(--dot-size)/2 - 1px),
      var(--dot-stroke) calc(var(--dot-size)/2),
      transparent calc(var(--dot-size)/2)
    ),
    radial-gradient(circle,
      var(--dot-fill) 0,
      var(--dot-fill) calc(var(--dot-size)/2 - 1px),
      var(--dot-stroke) calc(var(--dot-size)/2 - 1px),
      var(--dot-stroke) calc(var(--dot-size)/2),
      transparent calc(var(--dot-size)/2)
    );
  background-size:var(--dot-size) var(--dot-size);
  background-repeat:no-repeat;
  background-position:
    left  var(--dot-offset) top    var(--dot-offset),
    right var(--dot-offset) top    var(--dot-offset),
    left  var(--dot-offset) bottom var(--dot-offset),
    right var(--dot-offset) bottom var(--dot-offset);
}

/* ===== Combo class (dark) ON THE SAME ELEMENT ===== */
.title-highlight.dark-mode{
  /* override colors for dark */
  --border-color:rgba(105,236,197,0.38);   /* #69ECC5 @ 38% */
  --dot-stroke:rgba(133,255,219,0.32);     /* #85FFDB @ 32% */
  --dot-fill:rgba(37,65,57,1);       /* #69ECC5 @ 14% */

  /* TEXT GRADIENT (dark): top #85FFDB (100%) → bottom #00EAA5 (80%) */
  background:linear-gradient(to bottom, rgba(133,255,219,1) 0%, rgba(0,234,165,0.8) 100%) !important;
  -webkit-background-clip:text !important;
  background-clip:text !important;
  color:transparent !important;
  -webkit-text-fill-color:transparent !important;
}
  
  .dark-mode-title{
    background:linear-gradient(to bottom, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0.8) 100%) !important;
    -webkit-background-clip:text !important;
    background-clip:text !important;
    color:transparent !important;
    -webkit-text-fill-color:transparent !important;
  }
</style>

<style>
  
  /* ==================================== HIGHLIGHT CARD  ====================================*/

.highlight-card::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1.5px; /* grosor del borde */
  border-radius: inherit;
  background: linear-gradient(180deg, #85FFDB, rgba(0, 234, 165, 0.2));
  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  z-index: 1;
}
.testimonial-card-dark::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1.5px; /* grosor del borde */
  border-radius: inherit;
  background: linear-gradient(180deg, #85FFDB, rgba(0, 234, 165, 0.8));
  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  z-index: 1;
}

  .careers-card-highlight::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1.5px; /* grosor del borde */
  border-radius: inherit;
  background: linear-gradient(180deg, #85FFDB, rgba(0, 234, 165, 0.2));
  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  z-index: 1;
}
  
  
 .principle-card:hover .icon-x-small {
  transition: rotate(45deg);
}
  
  .primitive-card {
  transition: background-color 250ms ease;
}
  

.primitive-card::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1px; /* más fino */
  border-radius: inherit;

  background: linear-gradient(
    180deg,
    rgba(133, 255, 219, 0.35),
    rgba(0, 234, 165, 0.05)
  );

  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;

  opacity: 0;
  transition: opacity 250ms ease;
  pointer-events: none;
}
  
.primitive-card:hover::before {
  opacity: 1;
}  

  


.primitive-card:hover {
  background-color: rgba(133, 255, 219, 0.04);
}
  


  .quickstart-tab.w--current .tab-num {
    background-color: var(--new-primary--900);
  }

  
</style>
