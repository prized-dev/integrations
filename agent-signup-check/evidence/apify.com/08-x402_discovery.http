.dteshy{display:flex;align-items:center;justify-content:space-between;max-width:120rem;min-height:6.8rem;margin:0 auto;}/*!sc*/
.dteshy .Navigation-actions{display:none;animation:fadeIn 0.3s ease-in;}/*!sc*/
@keyframes fadeIn{0%{opacity:0;}100%{opacity:1;}}/*!sc*/
.dteshy .Navigation-actionsAsLinks{display:flex;align-items:center;flex-direction:row;gap:0.4rem;}/*!sc*/
.dteshy .Navigation-actionLinks{padding:0.8rem 1.2rem;color:var(--color-neutral-text);border-radius:8px;background-color:transparent;transition:background-color 0.3s ease-in;}/*!sc*/
.dteshy .Navigation-actionLinks:hover{background-color:var(--color-neutral-hover);}/*!sc*/
.dteshy .Navigation-contactSalesLink{visibility:hidden;display:none;}/*!sc*/
@media (min-width: 768px){.dteshy .Navigation-actions{display:flex;align-items:center;flex-direction:row;flex:1 0 auto;gap:0.8rem;justify-content:flex-end;width:auto;margin:0;}.dteshy .Navigation-contactSalesLink{visibility:visible;display:block;}}/*!sc*/
.dteshy .Navigation-menu{position:relative;display:flex;flex-direction:column;margin:1.6rem 0;padding:0 2.4rem 2.4rem 2.4rem;list-style-type:none;}/*!sc*/
.dteshy .Navigation-mobile-buttons{display:flex;flex-direction:column;align-items:center;gap:1.2rem;padding-bottom:1.6rem;}/*!sc*/
.dteshy .Navigation-mobile-buttons>*{width:100%;}/*!sc*/
.dteshy .WebHeader-navigation{overflow-y:auto;overflow-x:hidden;display:none;position:fixed;left:0px;top:0px;width:100%;background-color:var(--color-neutral-background);}/*!sc*/
@media (min-width: 768px){.dteshy .Navigation-mobile-buttons{display:none;}}/*!sc*/
@media (min-width: 1200px){.dteshy .Navigation-menu{display:flex;align-items:center;flex-direction:row;padding:0;}.dteshy .WebHeader-navigation{overflow-y:visible;overflow-x:visible;display:block;padding:0;margin:0;margin-left:2.4rem;position:unset;background-color:transparent;}}/*!sc*/
