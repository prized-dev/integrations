  [data-bunny-lightbox-init][data-player-status='playing'] .bunny-lightbox-player__dark {
    opacity: 0;
  }

  /* Play/Pause */
  [data-bunny-lightbox-init][data-player-status='playing'] .bunny-lightbox-player__playpause,
