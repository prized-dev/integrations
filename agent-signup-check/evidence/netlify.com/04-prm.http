      (function () {
        // Reflect the auth-hint cookie onto <html> before first paint so the
        // header renders the right auth state with no flash; AuthNav verifies
        // against the API afterwards and corrects a stale hint. Matched by
        // exact name — keep in sync with hasAuthHintCookie in src/utils/auth.ts.
        const applyAuthHint = () => {
          const authed = document.cookie.split(';').some((cookie) => cookie.split('=')[0].trim() === '_nf-auth-hint');
          document.documentElement.toggleAttribute('data-user-authed', authed);
        };

        applyAuthHint();
        document.addEventListener('astro:after-swap', applyAuthHint);
      })();
