#!/usr/bin/env python3
"""A stand-in for `gh pr create`. It records only what the tests check (whether the PR is a draft,
its head, base and title, and whether the body says the change needs review), never its arguments
as a whole, runs `git status` in the clone as gh does, and prints a PR URL."""

import json
import os
import subprocess
import sys

args = sys.argv[1:]
if args[:2] != ["pr", "create"]:
    sys.exit("fake gh: only `gh pr create`")


def value(flag):
    return args[args.index(flag) + 1] if flag in args else None


with open(value("--body-file")) as fh:
    body = fh.read()
with open(os.environ["FAKE_GH_LOG"], "w") as fh:
    json.dump({"draft": "--draft" in args, "head": value("--head"), "base": value("--base"),
               "title": value("--title"), "says_review": "Review it" in body}, fh)
# Like the real gh, look at the clone with git (the real one checks for uncommitted changes); a hook
# from the patch must not run here either.
subprocess.run(["git", "status", "--porcelain"], capture_output=True)
print("https://github.com/example/temps/pull/7")
