#!/bin/sh
# A shell for tests. As a login shell (`login-shell -ilc SCRIPT`, how the plugin asks for the key) it
# prints a banner, as chatty profiles do, and exports PRIZED_API_KEY when FAKE_LOGIN_KEY is set: a
# profile is read by login shells only. As ssh's `$SHELL -c CMD` it just runs CMD.
case "$1" in
  -*l*)
    echo "Welcome! (a profile that prints things)"
    if [ -n "${FAKE_LOGIN_KEY:-}" ]; then PRIZED_API_KEY=$FAKE_LOGIN_KEY; export PRIZED_API_KEY; fi
    ;;
esac
exec /bin/sh -c "$2"
