+def test_forwarder_carries_an_upgraded_connection_both_ways(forwarder):
+    """The env client runs episode I/O over a WebSocket: after the upgrade the
+    forwarder must copy bytes in both directions until either end closes."""
+
+    def upgrade_then_echo(conn, head, rest):
+        conn.sendall(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
+        while chunk := conn.recv(65536):
+            conn.sendall(chunk.upper())
+
+    _proxy, upstream, port = forwarder(upgrade_then_echo)
+    with socket.create_connection(("127.0.0.1", port)) as client:
+        client.sendall(b"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
+        handshake = b""
+        while b"\r\n\r\n" not in handshake:
+            handshake += client.recv(65536)
+        assert handshake.startswith(b"HTTP/1.1 101")
+        for message in (b"reset", b"step"):
+            client.sendall(message)
+            assert client.recv(65536) == message.upper()
+    lines = upstream.heads[0].split("\r\n")
+    assert "Connection: Upgrade" in lines and "Connection: close" not in lines
+    assert "Prized-Key: prized_secret" in lines
+
