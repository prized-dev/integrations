+def test_close_shuts_the_transport_down_without_unwrapping_tls():
+    """`SSLSocket.shutdown` drops TLS before it shuts the socket down, and a
+    thread still reading would then be handed ciphertext as data. `_close` must
+    go to the transport's own shutdown, whatever the socket's class overrides."""
+
+    class Overriding(socket.socket):
+        own_shutdown_called = False
+
+        def shutdown(self, how):  # stands in for SSLSocket's override
+            self.own_shutdown_called = True
+            super().shutdown(how)
+
+    ours, peer = socket.socketpair()
+    conn = Overriding(fileno=ours.detach())
+    with peer:
+        sandbox._close(conn)
+        assert not conn.own_shutdown_called
+        peer.settimeout(5)
+        assert peer.recv(1) == b""  # and the transport really was shut down
+
