+def test_forwarder_answers_a_client_that_stopped_sending_before_the_answer(forwarder):
+    """A client may close its sending half once the request is out. The answer
+    must still reach it: the forwarder keeps reading the upstream."""
+    _proxy, _upstream, port = forwarder(_answer_late_in_two_parts)
+    with socket.create_connection(("127.0.0.1", port)) as client:
+        client.sendall(b"GET /health HTTP/1.1\r\nHost: x\r\n\r\n")
