+    mod = types.ModuleType("prized")
+    mod.PrizedError = _FakePrizedError
+    mod.Sandbox = types.SimpleNamespace(create=ws.create, list=ws.list, connect=ws.connect)
+    monkeypatch.setitem(sys.modules, "prized", mod)
+    monkeypatch.setattr(sandbox, "resolve_api_key", lambda: "prized_" + "0" * 8)
+    _patch_recipe(monkeypatch)
+    return ws
