index 0000000000..f340f530c8
--- /dev/null
+++ b/examples/experimental/openenv/tb2_sandbox_prized.py
@@ -0,0 +1,790 @@
+"""Prized materialization of the per-task Terminal-Bench-2 sandbox recipe.
+
+The recipe itself — the shell layers that turn a task's official image into a
+combined task+env-server image — lives in ``tb2_sandbox_recipe`` (sibling
+module) and is provider-agnostic. This module is everything Prized-specific
+about turning that recipe into a running cloud sandbox.
+
+A Prized sandbox is a Firecracker microVM that can be paused with its memory
+kept, and forked — running or paused — into copies that each start with the
+parent's memory, disk and processes. Prized has no templates built from an
+image, so what the E2B and Novita backends keep as a named template is kept
+here as a paused sandbox, the task's *parent*:
+
+  ``ensure_task_parent(...)``  once per task: create a sandbox from the Docker
+      template, ``docker build`` the recipe on top of the task's official
+      image, start the env server in a container, wait for /health, and pause.
+      The parent carries a label derived from the task id AND a digest of
+      everything baked into it — so editing the recipe re-bakes automatically
+      instead of silently serving a stale parent.
+  ``create_task_sandbox(...)``  per-episode: fork the paused parent and return
+      ``(sandbox, base_url)``. The copy starts with the image built and the
+      env server already answering, so an episode pays for neither. The parent
+      stays paused, billing storage only.
+  bake CLI (``python tb2_sandbox_prized.py ...``)  pre-build parents for a
+      task list so the first training episode doesn't pay the image build.
+
+Two things here are Prized's alone. A sandbox port answers only requests that
+carry the workspace key in a header, which the env client cannot send, so
+``base_url`` is a loopback forwarder in this process that adds it (see
+``_AuthProxy``); nothing is exposed publicly. And a sandbox's lifetime is a
+hard cap on its running time that every copy gets afresh from its parent, so
+there is no keepalive thread: an orphan is deleted ``_MAX_RUNTIME_MIN`` after
+its fork however its creator died.
+
+Limits worth knowing before a wide run:
+
+  * Copies start on the parent's machine, as many as fit there; a fork that
+    does not fit is refused whole and retried by the shared backend as
+    throttling, and the episode fails once those retries run out.
+  * A workspace's disk quota counts paused sandboxes, and each parent holds
+    its whole disk (``OPENENV_PRIZED_MIN_DISK_GB`` at least): the quota
+    divided by that is how many parents can exist at once.
+  * One build per task is enforced within a rollout (``rollout_lock``). Two
+    rollouts in one workspace are not locked against each other: both build,
+    and each forks the newest paused parent.
+
+Sweeping a shared workspace: every sandbox made here carries
+``sandbox_labels``, so ``Sandbox.delete_by_labels({"openenv-launcher": "<you>"})``
+deletes one launcher's parents and episode sandboxes alike.
+
+All prized imports are lazy (in-function), mirroring ``tb2_sandbox_e2b``:
+offline unit tests and non-sandbox launches must not require the SDK.
+"""
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import re
+import selectors
+import shlex
+import socket
+import ssl
+import sys
+import threading
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+from urllib.parse import urlsplit
+
+import tb2_sandbox_recipe as recipe
+from tb2_sandbox_recipe import (
+    resolve_docker_image,
+    sandbox_labels,
+    server_cmd,
+    server_layer_commands,
+    task_env_resources,
+    wait_server_ready,
+)
+
+from miles.rollout.agentic.credentials import resolve_provider_api_key
+from miles.rollout.agentic.rollout_limits import rollout_lock
+
+# The user every build command and the env server run as. The TB2 task images
+# are built for a root agent (their solutions and tests apt-install freely), and
+# a task image may set its own USER, so both the build and the server pin root
+# rather than inherit whatever the image left.
+_BUILD_USER = "root"
+
+# Every knob describing ONE Prized sandbox lives here, next to the create that
+# uses it; the backend module keeps only the fan-out knobs. Read at import: a
+# rollout worker is a fresh process per run.
+_TEMPLATE = os.getenv("OPENENV_PRIZED_TEMPLATE", "prized-docker-v1")
+_BUILD_TIMEOUT_S = float(os.getenv("OPENENV_PRIZED_BUILD_TIMEOUT_S", "1800"))
+_READY_TIMEOUT_S = float(os.getenv("OPENENV_PRIZED_READY_TIMEOUT_S", "300"))
+# The sandbox disk holds Docker's image store as well as the task's own files,
+# and keeps the size it was created with.
+_MIN_DISK_GB = int(os.getenv("OPENENV_PRIZED_MIN_DISK_GB", "30"))
+_IMAGE_HEADROOM_GB = 10
+# How long a parent is kept once paused. A parent deleted for age is rebuilt by
+# the next episode of its task.
+_PARENT_KEEP_MIN = int(os.getenv("OPENENV_PRIZED_PARENT_KEEP_MIN", "1440"))
+
+# A sandbox the episode failed to delete would otherwise run until Prized's
+# default (a day). This much past the episode cap is the hard limit instead.
+_MAX_LIFETIME_SLACK_S = 30 * 60
+# The episode cap is read from its variable rather than from
+# openenv_agent_function, whose name for it is private (and which the bake CLI
+# must not import: it needs the agent loop's dependencies).
+_EPISODE_CAP_S = float(os.getenv("OPENENV_MAX_ROLLOUT_TIME_SECONDS", "3600"))
+# One number for both lifetimes, because a copy inherits its parent's: the
+# parent must outlive its own build, and a copy its episode.
+_MAX_RUNTIME_MIN = math.ceil((max(_EPISODE_CAP_S, _BUILD_TIMEOUT_S + _READY_TIMEOUT_S) + _MAX_LIFETIME_SLACK_S) / 60)
+
+_PARENT_LABEL = "openenv-tbench2-parent"
+# Set on a parent built to replace one whose copies had no env server. Such a
+# parent is never replaced for that reason again: if its copies have no server
+# either, the cause is not the parent, and rebuilding per episode would only
+# burn a build each time.
+_REBUILT_LABEL = "openenv-tbench2-rebuilt"
+_CONTAINER = "tb2-env"
+_PORT = 8000
+# How the env server's container is started. --init: the server would
+# otherwise be PID 1 and never reap the processes an agent leaves behind, as
+# the sandbox's own init does on the sibling providers. --no-healthcheck: a
+# task image's HEALTHCHECK is not part of the task. --entrypoint: a task image
+# may define one, and the server must start whatever it is. --user: the env
+# server executes the agent's commands, so the user it runs as IS the task
+# environment's user.
+_RUN_FLAGS = (
+    f"-d --name {_CONTAINER} -p {_PORT}:{_PORT} --init --no-healthcheck --user {_BUILD_USER} --entrypoint bash"
+)
+# File transfers reach only the sandbox user's home.
+_BUILD_DIR = "/home/prized/tb2-build"
+
+
+def task_resources(task_dir: Path) -> dict[str, int]:
+    """Sandbox shape from ``task.toml [environment]``.
+
+    A fork keeps its parent's shape, so the task's requirements go on the
+    parent's create, not on the fork.
+    """
+    cpus, memory_mb, storage_mb = task_env_resources(task_dir)
+    return {
+        "vcpu": cpus,
+        "memory_mb": memory_mb,
+        "disk_gb": max(_MIN_DISK_GB, math.ceil(storage_mb / 1024) + _IMAGE_HEADROOM_GB),
+    }
+
+
+def dockerfile(task_dir: Path) -> str:
+    """The recipe as a Dockerfile on the task's official image.
+
+    Each layer is an exec-form RUN, so Docker hands the command to ``sh -c``
+    as one JSON string and nothing in it meets the Dockerfile parser's own
+    escaping.
+    """
+    lines = [f"FROM {resolve_docker_image(task_dir, None)}", f"USER {_BUILD_USER}"]
+    lines += [f"RUN {json.dumps(['/bin/sh', '-c', command])}" for command in server_layer_commands(task_dir)]
+    return "\n".join(lines) + "\n"
+
+
+def parent_alias(task_dir: Path, *, command_timeout_s: int = recipe.COMMAND_TIMEOUT_S) -> str:
+    """Deterministic parent label: ``tb2-<task-id>-<digest>``.
+
+    The digest covers what shapes a copy's environment, all of which it
+    inherits from its parent: the template, the image definition (base image,
+    build user, every build command), how the container is started, the
+    server's command line — it is already running in the parent, so its runtime
+    knobs are baked — the sandbox shape, and the lifetime. The alias therefore
+    changes when a copy would differ: identical inputs fork the existing
+    parent, anything else re-bakes.
+
+    So a parent baked ahead of a run is found only if the bake ran with the
+    rollout's ``TB2_COMMAND_TIMEOUT_S``, template, disk floor, and lifetime
+    cap (which follows ``OPENENV_MAX_ROLLOUT_TIME_SECONDS``).
+    """
+    task_dir = Path(task_dir)
+    inputs = [
+        _TEMPLATE,
+        dockerfile(task_dir),
+        _RUN_FLAGS,
+        server_cmd(command_timeout_s, default_task_id=task_dir.name),
+        repr(sorted(task_resources(task_dir).items())),
+        str(_MAX_RUNTIME_MIN),
+    ]
+    digest = hashlib.sha256("\n".join(inputs).encode()).hexdigest()[:10]
+    slug = re.sub(r"[^a-z0-9-]", "-", task_dir.name.lower())[:40]
+    return f"tb2-{slug}-{digest}"
+
+
+def _connection_opts() -> dict:
+    """Per-call connection kwargs. Only the key is passed explicitly (for the
+    file indirection)."""
+    return {"api_key": resolve_api_key()}
+
+
+class SandboxCommandError(RuntimeError):
+    """A command this module ran in a sandbox exited non-zero.
+
+    Its own class because the message carries the command's output, and output
+    is not evidence of throttling: a build log may well say "rate limit"
+    (Docker Hub's pull limit does), and retrying it as a throttled create would
+    start a fresh parent and a fresh build every time.
+    """
+
+
+def _run(sandbox, command: str, *, timeout_s: float, what: str, on_logs=None) -> None:
+    """Run one command in *sandbox*; a non-zero exit is an error naming *what*."""
+    result = sandbox.exec(command, timeout=timeout_s, on_stdout=on_logs, on_stderr=on_logs)
+    if result.exit_code != 0:
+        tail = (result.stderr or result.stdout or "").strip()[-2000:]
+        raise SandboxCommandError(f"{what} failed in Prized sandbox {sandbox.id} (exit {result.exit_code}): {tail}")
+
+
+def _health_probe() -> str:
+    return f"curl -fsS --max-time 5 -o /dev/null http://127.0.0.1:{_PORT}/health"
+
+
+def _wait_health_command(timeout_s: float) -> str:
+    """Poll the env server from inside the sandbox; print its log if it never answers."""
+    attempts = max(1, int(timeout_s // 2))
+    return (
+        f"for i in $(seq {attempts}); do {_health_probe()} && exit 0; sleep 2; done; "
+        f"docker logs --tail 40 {_CONTAINER} >&2; exit 1"
+    )
+
+
+def _build_and_serve(parent, task_dir: Path, alias: str, command_timeout_s: int, on_logs=None) -> None:
+    """Build the task image in *parent* and leave the env server answering in a container."""
+    parent.files.write(f"{_BUILD_DIR}/Dockerfile", dockerfile(task_dir))
+    _run(
+        parent,
+        "timeout 60 sh -c 'until docker info >/dev/null 2>&1; do sleep 1; done'",
+        timeout_s=90,
+        what="waiting for the Docker daemon",
+    )
+    _run(
+        parent,
+        f"docker build -t {alias} {_BUILD_DIR}",
+        timeout_s=_BUILD_TIMEOUT_S,
+        what="docker build",
+        on_logs=on_logs,
+    )
+    cmd = server_cmd(command_timeout_s, default_task_id=task_dir.name)
+    _run(
+        parent,
+        f"docker run {_RUN_FLAGS} {alias} -c {shlex.quote(cmd)}",
+        timeout_s=120,
+        what="docker run",
+    )
+    _run(
+        parent,
+        _wait_health_command(_READY_TIMEOUT_S),
+        timeout_s=_READY_TIMEOUT_S + 30,
+        what="the env server's /health",
+    )
+
+
+def _parent_labels(task_dir: Path) -> dict[str, str]:
+    """Ownership labels for a parent: the recipe's, minus the run id.
+
+    A parent outlives the run that built it and is forked by later ones, so a
+    sweep of one run's sandboxes by ``openenv-run-id`` must not take it.
+    """
+    return {key: value for key, value in sandbox_labels(task_dir).items() if key != "openenv-run-id"}
+
+
+def _paused_parents(alias: str) -> list:
+    """Handles to the paused sandboxes labelled *alias*, newest first.
+
+    Paused is what makes one a parent: ``ensure_task_parent`` pauses only after
+    the env server answered, so a build that died midway is never mistaken for
+    one. A sandbox paused by hand mid-build would be; ``create_task_sandbox``
+    replaces a parent whose copy has no server.
+    """
+    from prized import Sandbox
+
+    return Sandbox.list(labels={_PARENT_LABEL: alias}, state="paused", **_connection_opts())
+
+
+def _discard(sandbox) -> None:
+    """Delete *sandbox* and release its connections; never raises."""
+    try:
+        sandbox.delete()
+    except Exception:
+        pass  # cleanup must not mask the real failure; the run-time cap reclaims it
+    try:
+        sandbox.close()
+    except Exception:
+        pass
+
+
+def ensure_task_parent(
+    task_dir: Path,
+    *,
+    force: bool = False,
+    command_timeout_s: int = recipe.COMMAND_TIMEOUT_S,
+    on_logs=None,
+    rebuilt: bool = False,
+) -> str:
+    """Build the task's parent unless a paused one carries its alias; return its sandbox id.
+
+    *rebuilt* marks a parent built here as the replacement for one whose copies
+    had no env server (see ``_REBUILT_LABEL``).
+
+    ``OPENENV_PRIZED_BUILD_TIMEOUT_S`` bounds the image build's wall clock (the
+    SDK kills the command past it), and a parent that fails anywhere before its
+    pause is deleted rather than left half-built.
+
+    *force* deletes the parents it replaces, and a copy still starting from one
+    of them fails: do not force a re-bake under a running rollout.
+    """
+    # In-function import, deliberately: the prized SDK is an optional
+    # dependency of this recipe (the launcher preflights it), so importing the
+    # module must not require it — the offline tests import this file with a
+    # fake `prized` in sys.modules, and the sibling backends defer their SDKs
+    # the same way.
+    from prized import Sandbox
+
+    task_dir = Path(task_dir)
+    alias = parent_alias(task_dir, command_timeout_s=command_timeout_s)
+    # one build per alias per rollout: a rollout fans out many episodes of the same task at once,
+    # and every concurrent miss would otherwise start its own multi-minute build
+    with rollout_lock(f"openenv-prized-build-{alias}"):
+        existing = _paused_parents(alias)
+        try:
+            if existing and not force:
+                return existing[0].id
+            labels = {**_parent_labels(task_dir), _PARENT_LABEL: alias}
+            if rebuilt:
+                labels[_REBUILT_LABEL] = "1"
+            parent = Sandbox.create(
+                _TEMPLATE,
+                **task_resources(task_dir),
+                labels=labels,
+                max_runtime_min=_MAX_RUNTIME_MIN,
+                # Off, explicitly, and inherited by every copy: an idle timer
+                # must never pause an episode mid-run, and "paused" must mean
+                # only "a finished parent" (see _paused_parents).
+                auto_pause_min=0,
+                auto_delete_min=_PARENT_KEEP_MIN,
+                **_connection_opts(),
+            )
+            try:
+                _build_and_serve(parent, task_dir, alias, command_timeout_s, on_logs)
+                parent.pause()
+            except BaseException:
+                _discard(parent)
+                raise
+            parent.close()
+            # A forced rebuild replaces the parents it found; only now, with
+            # the new one paused, is deleting them safe. One that will not
+            # delete is harmless: lookups take the newest, and it ages out.
+            for old in existing:
+                _discard(old)
+            return parent.id
+        finally:
+            for handle in existing:
+                handle.close()
+
+
+def _parent_is_gone(exc) -> bool:
+    """True when a fork failed because its parent can no longer be forked, and a new one could.
+
+    *exc* is the SDK's ``PrizedError``. A parent deleted for age between the
+    lookup and the fork answers 404; one that lost its paused memory answers
+    ``parent_not_forkable``. Neither is cured by waiting, and both are cured by
+    a new parent — except a parent too big for its machine to copy
+    (``parent_too_big``), which a rebuild would only reproduce.
+    """
+    return exc.status == 404 or (exc.code == "parent_not_forkable" and exc.reason != "parent_too_big")
+
+
+def _discard_parent(parent_id: str) -> None:
+    """Delete the parent *parent_id* so the next lookup, here and in every
+    sibling episode waiting on the build lock, misses and rebuilds once."""
+    from prized import PrizedError, Sandbox
+
+    try:
+        _discard(Sandbox.connect(parent_id, **_connection_opts()))
+    except PrizedError:
+        pass  # already gone
+
+
+def _fork_parent(task_dir: Path, command_timeout_s: int, *, rebuilt: bool = False):
+    """One running copy of the task's parent, as ``(copy, parent_id, parent_was_rebuilt)``,
+    rebuilding the parent once if it can no longer be forked."""
+    from prized import PrizedError, Sandbox
+
+    labels = sandbox_labels(task_dir)
+    for last_attempt in (False, True):
+        parent_id = ensure_task_parent(task_dir, command_timeout_s=command_timeout_s, rebuilt=rebuilt)
+        parent = None
+        try:
+            parent = Sandbox.connect(parent_id, **_connection_opts())
+            # The fork names its own labels, so the copy does not carry the
+            # parent label and is never mistaken for a parent.
+            (copy,) = parent.fork(1, labels=labels)
+            return copy, parent_id, _REBUILT_LABEL in parent.labels
+        except PrizedError as e:
+            if last_attempt or not _parent_is_gone(e):
+                raise
+            _discard_parent(parent_id)
+        finally:
+            if parent is not None:
+                parent.close()
+    raise AssertionError("unreachable")  # the second attempt returns or raises
+
+
+def _server_is_up_inside(sandbox) -> bool:
+    """Whether the env server answers from inside *sandbox*, whatever the route to it does."""
+    try:
+        return sandbox.exec(_health_probe(), timeout=30).exit_code == 0
+    except Exception:
+        return True  # cannot tell: do not blame the parent
+
+
+@dataclass
+class TaskSandbox:
+    """One episode's sandbox and the loopback forwarder in front of its port."""
+
+    sandbox: Any
+    proxy: "_AuthProxy | None"
+
+
+def create_task_sandbox(
+    task_dir: Path,
+    *,
+    command_timeout_s: int = recipe.COMMAND_TIMEOUT_S,
+    ready_timeout_s: float = _READY_TIMEOUT_S,
+):
+    """Create ONE per-episode sandbox for *task_dir* by forking its parent.
+
+    Returns ``(task_sandbox, base_url)``. Caller must ``delete_sandbox`` it
+    when the episode ends. First create for a task pays the parent build (via
+    ``ensure_task_parent``); repeats fork the paused parent.
+
+    Unlike the template backends, the env server is not exec'd here: it is
+    already running in the copy, as the parent had it. Its runtime knobs
+    (TB2_COMMAND_TIMEOUT_S) are therefore part of the parent's alias, and a
+    changed value re-bakes instead of being silently ignored.
+
+    A copy with no server in it means its parent has none (it was paused by
+    something other than a finished build): that parent is deleted and built
+    again — once per call, and once per parent: the replacement is marked, and
+    a marked parent whose copies have no server either is left for a person to
+    look at. A copy whose server is up but cannot be reached is not the
+    parent's fault, and the parent is left alone.
+    """
+    task_dir = Path(task_dir)
+    for last_attempt in (False, True):
+        sandbox, parent_id, parent_was_rebuilt = _fork_parent(task_dir, command_timeout_s, rebuilt=last_attempt)
+        handle = TaskSandbox(sandbox=sandbox, proxy=None)
+        try:
+            handle.proxy = _AuthProxy(sandbox.preview_url(_PORT), sandbox.preview_headers())
+            url = handle.proxy.start()
+            wait_server_ready(url, timeout_s=ready_timeout_s)
+            return handle, url
+        except Exception as e:
+            may_rebuild = isinstance(e, TimeoutError) and not last_attempt and not parent_was_rebuilt
+            parent_is_bad = may_rebuild and not _server_is_up_inside(sandbox)
+            try:
+                delete_sandbox(handle)
+            except Exception:
+                pass  # cleanup must not mask the real failure; the run-time cap reclaims it
+            if not parent_is_bad:
+                raise
+            _discard_parent(parent_id)
+    raise AssertionError("unreachable")  # the second attempt returns or raises
+
+
+def delete_sandbox(handle: TaskSandbox) -> None:
+    """Stop the forwarder and delete the sandbox created here."""
+    if handle.proxy is not None:
+        handle.proxy.stop()
+    try:
+        handle.sandbox.delete()
+    finally:
+        handle.sandbox.close()
+
+
+# --- the loopback forwarder --------------------------------------------------
+
+_MAX_HEAD_BYTES = 64 * 1024
+
+
+def _read_head(conn: socket.socket) -> tuple[bytes, bytes]:
+    """Read one HTTP request head; return (head incl. its blank line, bytes read past it)."""
+    data = b""
+    while b"\r\n\r\n" not in data:
+        if len(data) > _MAX_HEAD_BYTES:
+            raise OSError("request head too large")
+        chunk = conn.recv(65536)
+        if not chunk:
+            raise OSError("connection closed before the request head ended")
+        data += chunk
+    head, _, rest = data.partition(b"\r\n\r\n")
+    return head + b"\r\n\r\n", rest
+
+
+def _field_name(line: bytes) -> bytes:
+    return line.split(b":", 1)[0].strip().lower()
+
+
+def _is_upgrade(head: bytes) -> bool:
+    """Whether the request head asks to switch protocols (the env client's WebSocket)."""
+    return any(_field_name(line) == b"upgrade" for line in head.split(b"\r\n")[1:])
+
+
+def _rewrite_head(head: bytes, host: str, headers: dict[str, str]) -> bytes:
+    """*head* addressed to *host* and carrying *headers*.
+
+    A plain request is also marked ``Connection: close``: the header is added
+    per connection, not per request, so a connection must not be reused for a
+    second request that would go out without it. An upgrade keeps its own
+    Connection header.
+    """
+    request_line, *fields = head[: -len(b"\r\n\r\n")].split(b"\r\n")
+    upgrade = _is_upgrade(head)
+    replaced = {b"host", *(name.lower().encode() for name in headers)}
+    if not upgrade:
+        replaced.add(b"connection")
+    out = [request_line, b"Host: " + host.encode()]
+    out += [f"{name}: {value}".encode() for name, value in headers.items()]
+    if not upgrade:
+        out.append(b"Connection: close")
+    out += [line for line in fields if _field_name(line) not in replaced]
+    return b"\r\n".join(out) + b"\r\n\r\n"
+
+
+# How long a plain request's upstream may stay silent once its client has
+# stopped sending, before the connection is given up: an upstream that ignores
+# "Connection: close" must not hold a thread for the rest of the episode.
+_DRAIN_IDLE_S = 30.0
+# How long a peer may refuse to take bytes before the connection is given up.
+_SEND_STALL_S = 60.0
+
+
+def _wait(sock: socket.socket, event: int) -> None:
+    """Block until *sock* is ready for *event*, or raise once ``_SEND_STALL_S`` has passed.
+
+    ``selectors``, not ``select.select``: a rollout process holds several
+    descriptors per episode, and ``select`` refuses any numbered 1024 or above.
+    """
+    with selectors.DefaultSelector() as selector:
+        selector.register(sock, event)
+        if not selector.select(_SEND_STALL_S):
+            raise TimeoutError("the peer stopped taking or sending bytes")
+
+
+def _recv(sock: socket.socket) -> bytes | None:
+    """Bytes from a non-blocking socket: ``b""`` at end of stream, None when
+    nothing was ready after all (a TLS record that carried no data)."""
+    try:
+        return sock.recv(65536)
+    except (BlockingIOError, ssl.SSLWantReadError):
+        return None
+    except ssl.SSLWantWriteError:
+        # TLS has something of its own to send first; without the wait, a
+        # readable socket would bring the caller straight back here
+        _wait(sock, selectors.EVENT_WRITE)
+        return None
+
+
+def _send_all(sock: socket.socket, data: bytes) -> None:
+    """``sendall`` for a non-blocking socket: wait for room instead of failing."""
+    view = memoryview(data)
+    while view:
+        try:
+            view = view[sock.send(view) :]
+        except (BlockingIOError, ssl.SSLWantWriteError):
+            _wait(sock, selectors.EVENT_WRITE)
+        except ssl.SSLWantReadError:
+            _wait(sock, selectors.EVENT_READ)
+
+
+def _pump(client: socket.socket, upstream: socket.socket, *, upgrade: bool) -> None:
+    """Copy bytes both ways until the exchange is over, on the calling thread.
+
+    One thread for both directions, deliberately: the upstream is a TLS
+    connection, and a TLS connection must not be read on one thread while
+    another writes it. For the same reason nothing here half-closes the
+    upstream when the client stops sending — on a TLS socket that drops the
+    encryption rather than one direction.
+
+    Ends when the upstream closes (a plain request: it closes after answering,
+    as the rewritten head asked); when the client of an upgraded connection
+    closes; or when a plain request's client has stopped sending and the
+    upstream has had nothing to say for ``_DRAIN_IDLE_S``.
+
+    Each chunk is delivered before the next is read, in either direction, which
+    suits the env client's request-and-answer traffic. A peer that stops
+    reading for ``_SEND_STALL_S`` loses the connection rather than stalling it.
+    """
+    client.setblocking(False)
+    upstream.setblocking(False)
+    with selectors.DefaultSelector() as watched:
+        watched.register(upstream, selectors.EVENT_READ)
+        watched.register(client, selectors.EVENT_READ)
+        client_sending = True
+        while True:
+            if isinstance(upstream, ssl.SSLSocket) and upstream.pending():
+                ready = {upstream}  # decrypted already: the selector would not report it
+            else:
+                ready = {key.fileobj for key, _ in watched.select(None if client_sending else _DRAIN_IDLE_S)}
+                if not ready:
+                    return
+            if upstream in ready:
+                data = _recv(upstream)
+                if data == b"":
+                    return
+                if data:
+                    _send_all(client, data)
+            if client_sending and client in ready:
+                data = _recv(client)
+                if data == b"":
+                    if upgrade:
+                        return
+                    client_sending = False  # the answer may still be on its way
+                    watched.unregister(client)
+                elif data:
+                    _send_all(upstream, data)
+
+
+class _AuthProxy:
+    """Loopback forwarder that adds a sandbox port's auth header.
+
+    A Prized port URL answers only requests carrying the workspace key in a
+    ``Prized-Key`` header. The env client takes a bare base URL — it appends
+    ``/health`` and ``/ws`` and sends no headers of ours — so the URL handed to
+    it is this forwarder's: it listens on 127.0.0.1, opens one TLS connection
+    to the port URL per incoming connection, rewrites the request head (Host
+    and the auth header), and copies bytes both ways after that, which carries
+    a WebSocket as well as a plain request. The key never appears in a URL,
+    and the port stays private to the workspace.
+
+    Anything on this host can reach the sandbox's port through the forwarder
+    while the episode lives; it binds loopback only for that reason.
+    """
+
+    def __init__(self, target_url: str, headers: dict[str, str]):
+        target = urlsplit(target_url)
+        if target.scheme != "https" or not target.hostname:
+            raise ValueError(f"expected an https port URL, got {target_url!r}")
+        self._host = target.hostname
+        self._port = target.port or 443
+        self._host_header = target.netloc
+        self._headers = dict(headers)
+        self._tls = ssl.create_default_context()
+        self._listener: socket.socket | None = None
+        self._open: set[socket.socket] = set()
+        self._lock = threading.Lock()
+        self._stopped = False
+
+    def start(self) -> str:
+        """Start listening; return the ``http://127.0.0.1:<port>`` base URL."""
+        self._listener = socket.create_server(("127.0.0.1", 0))
+        port = self._listener.getsockname()[1]
+        threading.Thread(target=self._accept, name=f"tb2-prized-proxy-{port}", daemon=True).start()
+        return f"http://127.0.0.1:{port}"
+
+    def stop(self) -> None:
+        """Stop listening and end every connection still open. Safe to call twice.
+
+        Open connections are shut down here and closed by the threads serving
+        them: a socket closed under a thread that is reading it leaves that
+        thread waiting on nothing, or reading a descriptor that is no longer
+        the connection.
+        """
+        with self._lock:
+            self._stopped = True
+            open_now = list(self._open)
+            self._open.clear()
+        if self._listener is not None:
+            # shutdown, not just close: a thread blocked in accept() keeps a
+            # closed listener alive, and it would take one more connection
+            try:
+                self._listener.shutdown(socket.SHUT_RDWR)
+            except OSError:
+                pass
+            self._listener.close()
+        for conn in open_now:
+            _shutdown(conn)
+
+    def _track(self, conn: socket.socket) -> bool:
+        with self._lock:
+            if self._stopped:
+                return False
+            self._open.add(conn)
+            return True
+
+    def _accept(self) -> None:
+        while True:
+            try:
+                client, _addr = self._listener.accept()
+            except OSError:
+                return  # the listener was closed
+            threading.Thread(target=self._serve, args=(client,), daemon=True).start()
+
+    def _serve(self, client: socket.socket) -> None:
+        upstream = None
+        try:
+            if not self._track(client):
+                return
+            head, rest = _read_head(client)
+            upstream = self._connect_upstream()
+            if not self._track(upstream):
+                return
+            _send_all(upstream, _rewrite_head(head, self._host_header, self._headers) + rest)
+            _pump(client, upstream, upgrade=_is_upgrade(head))
+        except (OSError, ValueError):
+            pass  # ValueError: a selector handed a socket that is already closed
+        finally:
+            for conn in (client, upstream):
+                if conn is not None:
+                    with self._lock:
+                        self._open.discard(conn)
+                    _close(conn)
+
+    def _connect_upstream(self) -> socket.socket:
+        raw = socket.create_connection((self._host, self._port), timeout=30)
+        try:
+            upstream = self._tls.wrap_socket(raw, server_hostname=self._host)
+        except BaseException:
+            raw.close()
+            raise
+        upstream.settimeout(None)
+        return upstream
+
+
+def _shutdown(conn: socket.socket) -> None:
+    """End *conn* in both directions without closing it: whoever is reading it sees end of stream."""
+    try:
+        # The transport's own shutdown, not SSLSocket's: that one drops TLS
+        # first, and a thread still reading the socket would then be handed
+        # ciphertext as if it were the answer.
+        socket.socket.shutdown(conn, socket.SHUT_RDWR)
+    except OSError:
+        pass
+
+
+def _close(conn: socket.socket) -> None:
+    _shutdown(conn)
+    conn.close()
+
+
+_DEFAULT_API_KEY_FILE = "~/.config/prized/api_key"
+
+
+def resolve_api_key() -> str:
+    """The Prized API key: PRIZED_API_KEY, else the key file (see
+    recipe.resolve_provider_api_key for the file-indirection rationale). The
+    key needs Sandboxes: Write, which also opens the sandbox's port."""
+    return resolve_provider_api_key("PRIZED_API_KEY", "PRIZED_API_KEY_FILE", _DEFAULT_API_KEY_FILE)
+
+
+def bake(tasks_dir: Path, task_id: str, force: bool) -> None:
+    """Pre-build the parent for one task (optional warm cache)."""
+    task_dir = tasks_dir / task_id
+    alias = parent_alias(task_dir)
+    resources = task_resources(task_dir)
+    print(
+        f"[bake] {alias}  vcpu={resources['vcpu']} mem={resources['memory_mb']}MB disk={resources['disk_gb']}GB  "
+        f"(keyed on template={_TEMPLATE} lifetime={_MAX_RUNTIME_MIN}min command_timeout={recipe.COMMAND_TIMEOUT_S}s: "
+        "a rollout with other values builds its own)"
+    )
+    parent_id = ensure_task_parent(
+        task_dir,
+        force=force,
+        on_logs=lambda chunk: print(f"  | {chunk.rstrip()}", flush=True),
+    )
+    print(f"[done] {alias}  parent={parent_id}")
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    recipe.add_task_selection_args(ap)
+    ap.add_argument("--force", action="store_true", help="rebuild even when a paused parent exists")
+    args = ap.parse_args()
+
+    tasks_dir, task_ids = recipe.selected_task_ids(args)
+
+    for task_id in task_ids:
+        bake(tasks_dir, task_id, args.force)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
