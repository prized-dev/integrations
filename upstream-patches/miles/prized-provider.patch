+# --- the loopback forwarder -------------------------------------------------------
+
+
+class _Upstream:
+    """A stand-in for the sandbox's port URL, plain TCP or (with *tls*, a
+    server-side SSLContext) TLS: records each request head it receives and
+    answers with whatever the test scripted."""
+
+    def __init__(self, respond, tls=None):
+        self.heads = []
+        self._respond = respond
+        self._tls = tls
+        self._listener = socket.create_server(("127.0.0.1", 0))
+        self.address = self._listener.getsockname()
+        threading.Thread(target=self._accept, daemon=True).start()
+
+    def _accept(self):
+        while True:
+            try:
+                conn, _addr = self._listener.accept()
+            except OSError:
+                return
+            threading.Thread(target=self._serve, args=(conn,), daemon=True).start()
+
+    def _serve(self, conn):
+        if self._tls is not None:
+            try:
+                conn = self._tls.wrap_socket(conn, server_side=True)
+            except OSError:
+                conn.close()  # the caller refused our certificate
+                return
+        with conn:
+            data = b""
+            while b"\r\n\r\n" not in data:
+                chunk = conn.recv(65536)
+                if not chunk:
+                    return
+                data += chunk
+            head, _, rest = data.partition(b"\r\n\r\n")
+            self.heads.append(head.decode())
+            self._respond(conn, head.decode(), rest)
+
+    def close(self):
+        self._listener.close()
+
+
+@pytest.fixture
+def forwarder(monkeypatch):
+    """An _AuthProxy whose upstream connection is plain TCP to a local stand-in."""
+    made = []
+
+    def make(respond):
+        upstream = _Upstream(respond)
+        proxy = sandbox._AuthProxy("https://8000-sbx1.prized.test", {"Prized-Key": "prized_secret"})
+        monkeypatch.setattr(proxy, "_connect_upstream", lambda: socket.create_connection(upstream.address))
+        made.append((proxy, upstream))
+        port = int(proxy.start().rsplit(":", 1)[1])
+        return proxy, upstream, port
+
+    yield make
+    for proxy, upstream in made:
+        proxy.stop()
+        upstream.close()
+
+
+def _wait_until(condition, timeout_s: float = 5.0) -> None:
+    """Poll *condition* with a deadline, so a regression fails instead of hanging the suite."""
+    deadline = time.monotonic() + timeout_s
+    while not condition():
+        assert time.monotonic() < deadline, "timed out waiting"
+        time.sleep(0.01)
+
+
+def _recv_all(conn) -> bytes:
+    data = b""
+    while chunk := conn.recv(65536):
+        data += chunk
+    return data
+
+
+def _answer_ok(conn, head, rest):
+    conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
+
+
+def _answer_late_in_two_parts(conn, head, rest):
+    """Head, a pause, then the body: the forwarder has to read the upstream
+    again well after its client stopped sending."""
+    time.sleep(0.2)
+    conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n")
+    time.sleep(0.2)
+    conn.sendall(b"ok")
+
+
+def test_forwarder_adds_the_auth_header_and_readdresses_the_request(forwarder):
+    _proxy, upstream, port = forwarder(_answer_ok)
+    with socket.create_connection(("127.0.0.1", port)) as client:
+        client.sendall(b"GET /health HTTP/1.1\r\nHost: 127.0.0.1\r\nAccept: */*\r\n\r\n")
+        response = _recv_all(client)  # returns because the forwarder closes after the answer
+
+    assert response.endswith(b"\r\n\r\nok")
+    (head,) = upstream.heads
+    lines = head.split("\r\n")
+    assert lines[0] == "GET /health HTTP/1.1"
+    assert "Host: 8000-sbx1.prized.test" in lines and "Host: 127.0.0.1" not in lines
+    assert "Prized-Key: prized_secret" in lines
+    assert "Accept: */*" in lines
+    # one request per connection: a reused connection's second request would go out without the header
+    assert "Connection: close" in lines
+
+
+def test_forwarder_replaces_a_caller_supplied_auth_header(forwarder):
+    _proxy, upstream, port = forwarder(_answer_ok)
+    with socket.create_connection(("127.0.0.1", port)) as client:
+        client.sendall(b"GET / HTTP/1.1\r\nHost: x\r\nprized-key: something-else\r\nConnection: keep-alive\r\n\r\n")
+        _recv_all(client)
+    lines = upstream.heads[0].split("\r\n")
+    assert [line for line in lines if line.lower().startswith("prized-key")] == ["Prized-Key: prized_secret"]
+    assert [line for line in lines if line.lower().startswith("connection")] == ["Connection: close"]
+
