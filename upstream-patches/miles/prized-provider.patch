+def test_forwarder_over_tls_carries_an_upgraded_connection_both_ways(tls_forwarder):
+    """Either side may speak first and neither waits for the other: the server
+    pushes a message unprompted, then echoes what the client sends."""
+
+    def upgrade_push_then_echo(conn, head, rest):
+        conn.sendall(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
+        conn.sendall(b"server-first")
+        while chunk := conn.recv(65536):
+            conn.sendall(chunk.upper())
+
+    _proxy, _upstream, port = tls_forwarder(upgrade_push_then_echo)
+    with socket.create_connection(("127.0.0.1", port)) as client:
+        client.settimeout(5)
+        client.sendall(b"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
+        received = b""
+        while not received.endswith(b"server-first"):
+            received += client.recv(65536)
+        assert received.startswith(b"HTTP/1.1 101")
+        for message in (b"reset", b"x" * 100_000):  # the second spans many TLS records
+            client.sendall(message)
+            echoed = b""
+            while len(echoed) < len(message):
+                echoed += client.recv(65536)
+            assert echoed == message.upper()
+
