+def test_forwarder_gives_up_an_upstream_that_never_closes(forwarder, monkeypatch):
+    """`Connection: close` is a request. An upstream that ignores it must not
+    hold a thread and two sockets for the rest of the episode once the client
+    has its answer and is gone."""
+    monkeypatch.setattr(sandbox, "_DRAIN_IDLE_S", 0.05)
+    release = threading.Event()
+
+    def answer_and_linger(conn, head, rest):
+        _answer_ok(conn, head, rest)
+        release.wait(60)  # far longer than the wait below: only the forwarder can end this
+
+    proxy, _upstream, port = forwarder(answer_and_linger)
+    with socket.create_connection(("127.0.0.1", port)) as client:
+        client.sendall(b"GET /health HTTP/1.1\r\nHost: x\r\n\r\n")
+        assert client.recv(65536).endswith(b"\r\n\r\nok")
+    try:
+        _wait_until(lambda: not proxy._open)  # both sockets released without the upstream closing
+    finally:
+        release.set()
+
