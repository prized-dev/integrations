+def test_forwarder_works_with_descriptors_numbered_above_1023(forwarder):
+    """`select()` refuses any descriptor numbered 1024 or above, and a rollout
+    process holds several per episode: the forwarder must not depend on it."""
+    resource = pytest.importorskip("resource")
+    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
+    wanted = 1300
+    if hard != resource.RLIM_INFINITY and hard < wanted:
+        pytest.skip(f"this machine allows only {hard} open files")
+    held = []
+    try:
+        resource.setrlimit(resource.RLIMIT_NOFILE, (max(soft, wanted), hard))
+        while not held or held[-1].fileno() < 1100:  # every lower number is now taken
+            held.append(socket.socket())
+        _proxy, _upstream, port = forwarder(_answer_ok)
+        with socket.create_connection(("127.0.0.1", port)) as client:
+            assert client.fileno() >= 1024
+            client.sendall(b"GET /health HTTP/1.1\r\nHost: x\r\n\r\n")
+            client.settimeout(5)
+            assert _recv_all(client).endswith(b"\r\n\r\nok")
+    finally:
+        for sock in held:
+            sock.close()
+        resource.setrlimit(resource.RLIMIT_NOFILE, (soft, hard))
+
