diff --git a/examples/experimental/openenv/openenv_prized_agent_function.py b/examples/experimental/openenv/openenv_prized_agent_function.py
new file mode 100644
index 0000000000..7bb4441c0b
--- /dev/null
+++ b/examples/experimental/openenv/openenv_prized_agent_function.py
@@ -0,0 +1,129 @@
+"""Prized-sandbox variant of the OpenEnv tbench2 agent function.
+
+A drop-in alternative to ``openenv_agent_function.run`` for
+``--custom-agent-function-path``: instead of sharing one env server
+(OPENENV_ENV_URL), every episode gets its OWN sandbox on
+`Prized <https://prized.dev/docs/sandboxes>`_ — a fork of a paused sandbox that
+already holds the task's OFFICIAL image, the env server layer, and the env
+server itself, running. The fork is deleted when the episode ends.
+
+The agent loop and training wrapper live in ``openenv_agent_function``, and
+everything about running episodes on per-episode sandboxes is
+``openenv_sandbox_common``'s ``SandboxBackend``. This module is only what is
+Prized-specific: how one sandbox comes into being, which of its SDK's errors
+are worth retrying, and its knobs. The image recipe lives in
+``tb2_sandbox_recipe`` and its Prized materialization in
+``tb2_sandbox_prized``; like the other sandbox backends, this variant needs the
+pinned tbench2_env install from the README (canonical test.sh scoring and
+verifier-asset withholding built into the server).
+
+Env vars (the agent-loop ones in ``openenv_agent_function`` apply too):
+  OPENENV_TB2_TASKS_DIR       path to a terminal-bench-2 checkout. One paused
+                    parent sandbox is built per task under a recipe-digest
+                    label (first episode of a task pays the build; repeats
+                    fork the parent), or pre-baked via the tb2_sandbox_prized
+                    CLI.
+  PRIZED_API_KEY / PRIZED_API_KEY_FILE   key supply on the contract every
+                    backend shares (file default ~/.config/prized/api_key;
+                    launchers forward the PATH, never the value).
+  OPENENV_PRIZED_CREATE_CONCURRENCY   max in-flight sandbox creates (default 4).
+  OPENENV_PRIZED_CREATE_MAX_RETRIES   how many throttled creates to retry (default 8).
+
+Everything describing ONE sandbox — its template, lifetime and the ready
+deadline — is documented and read in ``tb2_sandbox_prized``, and the per-exec
+timeout inside it (TB2_COMMAND_TIMEOUT_S) in ``tb2_sandbox_recipe``, next to
+the code each one steers.
+"""
+
+import logging
+from pathlib import Path
+from typing import Any
+
+import openenv_sandbox_common as common
+import tb2_sandbox_prized
+
+logger = logging.getLogger(__name__)
+
+# The API's own codes for "not now": the edge's rate limit, a fork that does
+# not fit on the parent's machine at the moment, no sandbox capacity free, a
+# parent whose machine is being replaced (a paused sandbox is moved off it), a
+# parent caught between two states, and forking paused for maintenance.
+_RETRY_LATER_CODES = frozenset(
+    {
+        "rate_limited",
+        "fork_capacity",
+        "sandbox_capacity",
+        "fork_unsupported_host",
+        "parent_not_running",
+        "sandbox_fork_disabled",
+    }
+)
+# Workspace quotas that no running episode will give back: a lifetime longer
+# than the workspace allows, and disk held by paused sandboxes (the parents).
+_QUOTAS_WAITING_CANNOT_CURE = frozenset({"max_runtime", "retained_disk"})
+
+
+def _retry_later(code: str, reason: str | None) -> bool:
+    """Whether the API's *code* and *reason* describe a condition that passes on its own."""
+    if code == "sandbox_quota_exceeded":
+        return reason not in _QUOTAS_WAITING_CANNOT_CURE
+    if code == "sandbox_error":
+        # a fork that was accepted and then undone because the copy no longer fit
+        return (reason or "").startswith("fork_capacity")
+    return code in _RETRY_LATER_CODES
+
+
+# The sandbox's env server is the tbench2_env baked by the recipe, installed
+# per the README (at or after the huggingface/OpenEnv#1025 merge): canonical
+# tests/test.sh scoring built into `evaluate`, task WORKDIR resolved
+# server-side, verifier assets withheld. The launcher preflight rejects an
+# older install outright, and the shared agent loop's harness-marker guard
+# backstops it per episode.
+#
+# Copies start on their parent's machine, so a fanned-out rollout of one task
+# can ask for more than fits there at once; the shared backend caps in-flight
+# creates per rollout and retries refused ones with jittered exponential
+# backoff (knobs: OPENENV_PRIZED_CREATE_*).
+def _is_throttle_error(exc: BaseException) -> bool:
+    """True when a sandbox create failed only because Prized would not seat it yet.
+
+    The SDK raises one error class and carries the API's machine-readable code
+    and reason on it, so an SDK error is decided on those alone — its text
+    always leads with the HTTP status, which would make every 429 look
+    retryable, including the quotas that waiting cannot cure. A command that
+    failed inside a sandbox is never throttling, whatever its output says. The
+    text match is for anything else: limits that only surface as text (a
+    proxy's 429).
+    """
+    # In-function import, deliberately: this is the class's only use site, it
+    # only runs on the failure path (where prized is already in sys.modules,
+    # having just raised `exc`), and offline tests must not require the SDK.
+    try:
+        from prized import PrizedError
+
+        if isinstance(exc, PrizedError):
+            return _retry_later(exc.code, exc.reason)
+    except ImportError:  # pragma: no cover - only without the prized SDK
+        pass
+    if isinstance(exc, tb2_sandbox_prized.SandboxCommandError):
+        return False
+    return common.throttle_text(exc)
+
+
+def _start_sandbox(task_id: str, tasks_dir: str) -> tuple[Any, str]:
+    handle, url = tb2_sandbox_prized.create_task_sandbox(Path(tasks_dir) / task_id)
+    return (lambda: tb2_sandbox_prized.delete_sandbox(handle)), url
+
+
+BACKEND = common.SandboxBackend(
+    provider="Prized",
+    start_sandbox=_start_sandbox,
+    is_throttle=_is_throttle_error,
+    logger=logger,
+    **common.backend_knobs("PRIZED"),
+)
+
+# Module-level entry points: `--custom-agent-function-path` resolves a module
+# attribute, and the sibling tools reach run_episode the same way.
+run_episode = BACKEND.run_episode
+run = BACKEND.run
