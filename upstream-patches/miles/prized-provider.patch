+def test_forwarder_passes_a_request_body_through(forwarder):
+    seen = []
+
+    def echo_body(conn, head, rest):
+        body = rest
+        while len(body) < 5:
+            body += conn.recv(65536)
+        seen.append(body)
+        conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")
+
+    _proxy, _upstream, port = forwarder(echo_body)
+    with socket.create_connection(("127.0.0.1", port)) as client:
+        client.sendall(b"POST /reset HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhe")
+        client.sendall(b"llo")
+        assert _recv_all(client).startswith(b"HTTP/1.1 200 OK")
+    assert seen == [b"hello"]
+
