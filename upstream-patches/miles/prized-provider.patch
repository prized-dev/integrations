diff --git a/tests/fast/examples/experimental/openenv/test_openenv_prized_agent_function.py b/tests/fast/examples/experimental/openenv/test_openenv_prized_agent_function.py
new file mode 100644
index 0000000000..7c14d4bc98
--- /dev/null
+++ b/tests/fast/examples/experimental/openenv/test_openenv_prized_agent_function.py
@@ -0,0 +1,152 @@
+"""Offline unit tests for the Prized-sandbox agent function (no network, no GPU).
+
+Runs on every PR (stage-a-cpu, by the tests/fast/ convention); locally:
+
+    pytest tests/fast/examples/experimental/openenv -q
+
+Covers only what is Prized's own. Episode dispatch, create throttling, backoff
+budgets and the cancel-mid-create reaper belong to the shared SandboxBackend and are
+proven once in test_openenv_sandbox_common.py; what remains here is which of
+this SDK's errors count as throttling, and that the start hook wires the
+materialization (per-task dir, delete-on-close).
+"""
+
+import sys
+import types
+from pathlib import Path
+
+import openenv_prized_agent_function as opaf
+import pytest
+
+
+class _FakePrizedError(Exception):
+    """The SDK's one error class: the API's code and reason ride on it, and
+    its text always leads with the HTTP status."""
+
+    def __init__(self, code, *, status=None, reason=None):
+        super().__init__(f"{status} {code}" + (f" ({reason})" if reason else ""))
+        self.code, self.status, self.reason = code, status, reason
+
+
+@pytest.fixture
+def fake_prized(monkeypatch):
+    mod = types.ModuleType("prized")
+    mod.PrizedError = _FakePrizedError
+    monkeypatch.setitem(sys.modules, "prized", mod)
+    return mod
+
+
+# --- start hook -------------------------------------------------------------
+
+
+def test_start_hook_creates_per_task_and_closes_by_deleting(monkeypatch):
+    """The sandbox is per-task (tasks_dir/task_id) and close_fn deletes it — the
+    paused parent stays, the episode's fork must not."""
+    deleted = []
+    created = {}
+
+    def fake_create(task_dir, **kwargs):
+        created.update(task_dir=task_dir, kwargs=kwargs)
+        return "sandbox-handle", "http://127.0.0.1:40123"
+
+    monkeypatch.setattr(opaf.tb2_sandbox_prized, "create_task_sandbox", fake_create)
+    monkeypatch.setattr(opaf.tb2_sandbox_prized, "delete_sandbox", deleted.append)
+
+    close_fn, url = opaf._start_sandbox("regex-chess", "/tasks")
+
+    assert url == "http://127.0.0.1:40123"
+    assert created["task_dir"] == Path("/tasks/regex-chess")
+    # The backend passes only what identifies the sandbox; every deadline is
+    # the materialization's own default, so the two cannot drift apart.
+    assert created["kwargs"] == {}
+    close_fn()
+    assert deleted == ["sandbox-handle"]
+
+
+def test_module_exposes_the_backend_entry_points():
+    assert opaf.BACKEND.provider == "Prized"
+    assert opaf.run == opaf.BACKEND.run and opaf.run_episode == opaf.BACKEND.run_episode
+
+
+# --- throttle classification ------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("code", "status"),
+    [
+        ("rate_limited", 429),
+        ("fork_capacity", 409),  # the copy does not fit on its parent's machine right now
+        ("sandbox_capacity", 503),
+        ("sandbox_quota_exceeded", 429),  # running episodes give quota back as they end
+        ("fork_unsupported_host", 409),  # the parent's machine is being replaced; a paused parent is moved
+        ("parent_not_running", 409),  # the parent is between two states
+    ],
+)
+def test_capacity_and_rate_codes_are_retryable(fake_prized, code, status):
+    assert opaf._is_throttle_error(_FakePrizedError(code, status=status))
+
+
+def test_a_fork_undone_for_capacity_is_retryable(fake_prized):
+    """A fork the API accepted and then undid surfaces as `sandbox_error` with
+    no HTTP status, the cause in its reason: the same condition as a
+    `fork_capacity` refusal, so the same answer."""
+    assert opaf._is_throttle_error(_FakePrizedError("sandbox_error", reason="fork_capacity"))
+    assert not opaf._is_throttle_error(_FakePrizedError("sandbox_error", reason="runtime_degraded"))
+    assert not opaf._is_throttle_error(_FakePrizedError("sandbox_error"))
+
+
+@pytest.mark.parametrize(
+    ("code", "status", "reason"),
+    [
+        ("paid_balance_required", 402, None),
+        ("template_inactive", 409, None),
+        ("parent_not_forkable", 409, "memory_discarded"),
+        ("invalid_api_key", 401, None),
+        # quotas no running episode gives back: a lifetime longer than the
+        # workspace allows, and disk held by paused parents
+        ("sandbox_quota_exceeded", 429, "max_runtime"),
+        ("sandbox_quota_exceeded", 429, "retained_disk"),
+    ],
+)
+def test_errors_that_waiting_cannot_cure_are_not_retried(fake_prized, code, status, reason):
+    assert not opaf._is_throttle_error(_FakePrizedError(code, status=status, reason=reason))
+
+
+def test_an_sdk_error_is_judged_by_its_code_not_its_text(fake_prized):
+    """The SDK's message leads with the status, so the shared text match would
+    call every 429 retryable; an SDK error never reaches it."""
+    permanent = _FakePrizedError("sandbox_quota_exceeded", status=429, reason="max_runtime")
+    assert "429" in str(permanent)
+    assert not opaf._is_throttle_error(permanent)
+
+
+def test_non_sdk_errors_fall_back_to_the_shared_text_match(fake_prized):
+    assert opaf._is_throttle_error(Exception("HTTP 429"))
+    assert opaf._is_throttle_error(Exception("Too Many Requests"))
+    assert not opaf._is_throttle_error(RuntimeError("docker build failed"))
+
+
+def test_a_failed_build_is_never_throttling_whatever_its_log_says(fake_prized):
+    """A build log can quote Docker Hub's pull limit word for word. Retrying it
+    as a throttled create would start a new parent and a new build each time."""
+    log = "toomanyrequests: You have reached your unauthenticated pull rate limit. 429 Too Many Requests"
+    failed = opaf.tb2_sandbox_prized.SandboxCommandError(
+        f"docker build failed in Prized sandbox sbx_1 (exit 1): {log}"
+    )
+    assert opaf.common.throttle_text(failed)  # the text alone WOULD match
+    assert not opaf._is_throttle_error(failed)
+
+
+def test_is_throttle_error_typed_prized_class():
+    """The real SDK's error is recognized by its code; a sibling code is not."""
+    sdk = pytest.importorskip("prized")
+    assert opaf._is_throttle_error(sdk.PrizedError("fork_capacity", status=409))
+    assert not opaf._is_throttle_error(sdk.PrizedError("invalid_api_key", status=401))
+
+
+def test_is_throttle_error_without_the_sdk_installed(monkeypatch):
+    """The typed check is best-effort: the backend still classifies by text when the
+    SDK (or that class) is absent, rather than failing the classification."""
+    monkeypatch.setitem(sys.modules, "prized", types.ModuleType("prized"))
+    assert opaf._is_throttle_error(Exception("HTTP 429"))
+    assert not opaf._is_throttle_error(RuntimeError("docker build failed"))
