+# --- fake prized SDK -----------------------------------------------------------
+
+
+class _FakePrizedError(Exception):
+    def __init__(self, code, *, status=None, reason=None):
+        super().__init__(f"{status} {code}")
+        self.code, self.status, self.reason = code, status, reason
+
+
+class _FakeResult:
+    def __init__(self, exit_code=0, stdout="", stderr=""):
+        self.exit_code, self.stdout, self.stderr = exit_code, stdout, stderr
+
+
+class _FakeSandbox:
+    """Stands in for prized.Sandbox: one HANDLE to a microVM in the fake
+    workspace below. As in the SDK, several handles may name one sandbox, and a
+    closed handle refuses every further call."""
+
+    def __init__(self, workspace, vm):
+        self.workspace, self.vm, self.closed = workspace, vm, False
+        self.files = types.SimpleNamespace(write=self._write)
+
+    id = property(lambda self: self.vm.id)
+    state = property(lambda self: self.vm.state)
+    labels = property(lambda self: self.vm.labels)
+    kwargs = property(lambda self: self.vm.kwargs)
+
+    def _open(self):
+        assert not self.closed, f"call on a closed handle to {self.id}"
+        return self.vm
+
+    def _write(self, path, data):
+        self._open().written[path] = data
+
+    def exec(self, command, **kwargs):
+        self._open().ran.append((command, kwargs))
+        return self.workspace.exec_result(command)
+
+    def pause(self):
+        self._open().state = "paused"
+        self.workspace.events.append(("pause", self.id))
+
+    def fork(self, count=1, *, labels=None):
+        parent = self._open()
+        if self.workspace.fork_error is not None:
+            raise self.workspace.fork_error
+        return [
+            self.workspace.add(parent.labels if labels is None else labels, {"forked_from": parent.id})
+            for _ in range(count)
+        ]
+
+    def delete(self):
+        vm = self._open()
+        if self.workspace.delete_error is not None:
+            raise self.workspace.delete_error
+        vm.state = "deleted"
+        self.workspace.events.append(("delete", self.id))
+
+    def close(self):
+        self.closed = True
+
+    def preview_url(self, port):
+        return f"https://{port}-{self._open().id}.prized.test"
+
+    def preview_headers(self):
+        return {"Prized-Key": "prized_" + "0" * 8}
+
+
+class _FakeWorkspace:
+    """The sandboxes one API key sees, and what the SDK's classmethods do to them."""
+
+    def __init__(self):
+        self.vms = []
+        self.handles = []
+        self.events = []
+        self.fork_error = None
+        self.delete_error = None
+        self.exec_result = lambda command: _FakeResult()
+
+    def _handle(self, vm):
+        handle = _FakeSandbox(self, vm)
+        self.handles.append(handle)
+        return handle
+
+    def add(self, labels, kwargs, state="running"):
+        vm = types.SimpleNamespace(
+            id=f"sbx_{len(self.vms)}", labels=dict(labels), kwargs=kwargs, state=state, ran=[], written={}
+        )
+        self.vms.append(vm)
+        return self._handle(vm)
+
+    def create(self, template, *, labels=None, **kwargs):
+        self.events.append(("create", template))
+        return self.add(labels or {}, {"template": template, **kwargs})
+
+    def list(self, *, labels=None, state=None, **kwargs):
+        # a fresh handle per call, newest first, as the SDK returns them
+        return [
+            self._handle(vm)
+            for vm in reversed(self.vms)
+            if vm.state == state and all(vm.labels.get(k) == v for k, v in (labels or {}).items())
+        ]
+
+    def connect(self, sandbox_id, **kwargs):
+        for vm in self.vms:
+            if vm.id == sandbox_id and vm.state != "deleted":
+                return self._handle(vm)
+        raise _FakePrizedError("not_found", status=404)
+
+    def get(self, sandbox_id):
+        return next(vm for vm in self.vms if vm.id == sandbox_id)
+
+    def creates(self):
+        return [event for event in self.events if event[0] == "create"]
+
+    def open_handles(self):
+        return [handle for handle in self.handles if not handle.closed]
+
+
+@pytest.fixture
