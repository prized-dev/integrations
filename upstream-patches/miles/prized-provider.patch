+def test_forwarder_stop_ends_connections_still_open(forwarder):
+    """An episode that ends mid-stream must not leave its sockets behind."""
+    proxy, upstream, port = forwarder(lambda conn, head, rest: conn.recv(65536))  # never answers
+    with socket.create_connection(("127.0.0.1", port)) as client:
+        client.sendall(b"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
+        _wait_until(lambda: upstream.heads)  # the connection is established end to end
+        proxy.stop()
+        client.settimeout(5)
+        assert client.recv(65536) == b""  # closed by the forwarder, not timed out
+    with pytest.raises(OSError):
+        socket.create_connection(("127.0.0.1", port), timeout=1)
+    proxy.stop()  # safe to call twice
+
