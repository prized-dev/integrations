diff --git a/tests/fast/examples/experimental/openenv/test_tb2_sandbox_prized.py b/tests/fast/examples/experimental/openenv/test_tb2_sandbox_prized.py
new file mode 100644
index 0000000000..dc943984ac
--- /dev/null
+++ b/tests/fast/examples/experimental/openenv/test_tb2_sandbox_prized.py
@@ -0,0 +1,1085 @@
+"""Tests for the Prized sandbox half: parent labelling, the per-task parent
+build, the per-episode fork, the lifetime cap, key supply, and the loopback
+forwarder that adds the port's auth header.
+
+Runs on every PR (stage-a-cpu, by the tests/fast/ convention); locally:
+
+    pytest tests/fast/examples/experimental/openenv -q
+"""
+
+import datetime
+import json
+import socket
+import ssl
+import sys
+import threading
+import time
+import types
+from pathlib import Path
+
+import pytest
+
+import tb2_sandbox_prized as sandbox
+
+
+# --- parent labelling ----------------------------------------------------------
+
+
+def _patch_recipe(
+    monkeypatch,
+    base="ghcr.io/laude/task:1.0",
+    commands=("apt-get install -y curl",),
+    resources=None,
+):
+    resources = resources or {"vcpu": 1, "memory_mb": 2048, "disk_gb": 30}
+    monkeypatch.setattr(sandbox, "resolve_docker_image", lambda task_dir, override: base)
+    monkeypatch.setattr(sandbox, "server_layer_commands", lambda task_dir: list(commands))
+    monkeypatch.setattr(sandbox, "task_resources", lambda task_dir: dict(resources))
+    monkeypatch.setattr(sandbox, "sandbox_labels", lambda task_dir: {"openenv-tbench2-task": Path(task_dir).name})
+    monkeypatch.setattr(
+        sandbox, "server_cmd", lambda timeout, default_task_id="": f"serve {default_task_id} {timeout}"
+    )
+
+
+def test_parent_alias_is_deterministic_and_sanitized(monkeypatch):
+    _patch_recipe(monkeypatch)
+    a1 = sandbox.parent_alias(Path("/tasks/Regex_Chess"))
+    a2 = sandbox.parent_alias(Path("/tasks/Regex_Chess"))
+    assert a1 == a2
+    assert a1.startswith("tb2-regex-chess-")  # lowercased, non [a-z0-9-] mapped to '-'
+    # bounded whatever the task is called: it is also a lock file's and a Docker image's name
+    assert len(sandbox.parent_alias(Path("/tasks/" + "x" * 200))) <= 64
+
+
+def test_parent_alias_tracks_recipe_content(monkeypatch):
+    """The digest must cover base image AND build commands: editing either
+    re-bakes instead of silently forking a stale parent."""
+    _patch_recipe(monkeypatch)
+    original = sandbox.parent_alias(Path("/tasks/t"))
+    _patch_recipe(monkeypatch, commands=("apt-get install -y curl", "extra step"))
+    assert sandbox.parent_alias(Path("/tasks/t")) != original
+    _patch_recipe(monkeypatch, base="ghcr.io/laude/task:2.0")
+    assert sandbox.parent_alias(Path("/tasks/t")) != original
+
+
+def test_parent_alias_tracks_the_sandbox_shape(monkeypatch):
+    """A fork keeps its parent's shape, so a task.toml resource bump must
+    re-bake instead of forking under-provisioned sandboxes."""
+    _patch_recipe(monkeypatch)
+    small = sandbox.parent_alias(Path("/tasks/t"))
+    _patch_recipe(monkeypatch, resources={"vcpu": 4, "memory_mb": 8192, "disk_gb": 30})
+    assert sandbox.parent_alias(Path("/tasks/t")) != small
+
+
+def test_parent_alias_tracks_everything_a_copy_inherits(monkeypatch):
+    """The env server is already running in the parent and a copy gets the
+    parent's lifetime, so the server's command line, the template and the
+    lifetime are all part of the baked artifact."""
+    _patch_recipe(monkeypatch)
+    before = sandbox.parent_alias(Path("/tasks/t"))
+    assert sandbox.parent_alias(Path("/tasks/t"), command_timeout_s=5) != before
+    monkeypatch.setattr(sandbox, "_TEMPLATE", "some-other-template")
+    with_template = sandbox.parent_alias(Path("/tasks/t"))
+    assert with_template != before
+    monkeypatch.setattr(sandbox, "_MAX_RUNTIME_MIN", sandbox._MAX_RUNTIME_MIN + 1)
+    with_lifetime = sandbox.parent_alias(Path("/tasks/t"))
+    assert with_lifetime != with_template
+    monkeypatch.setattr(sandbox, "_RUN_FLAGS", sandbox._RUN_FLAGS + " --cap-add SYS_PTRACE")
+    assert sandbox.parent_alias(Path("/tasks/t")) != with_lifetime
+
+
+def test_dockerfile_carries_each_layer_verbatim_as_root(monkeypatch):
+    """Exec-form RUN: the command reaches `sh -c` as one JSON string, so quotes,
+    backslashes and dollar signs in a recipe layer survive the Dockerfile."""
+    tricky = "echo \"a $HOME\" 'b\\c' && printf '%s\\n' x"
+    _patch_recipe(monkeypatch, commands=("apt-get update", tricky))
+    lines = sandbox.dockerfile(Path("/tasks/t")).splitlines()
+    assert lines[0] == "FROM ghcr.io/laude/task:1.0"
+    assert lines[1] == "USER root"  # before the first layer: a task image may set its own USER
