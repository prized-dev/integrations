+def test_forwarder_stop_mid_stream_hands_the_client_nothing_but_plaintext(tls_forwarder):
+    """Stopping while the upstream is still sending must end the connection
+    cleanly: every byte the client ever receives is the upstream's plaintext,
+    never the TLS records underneath it."""
+    handshake = b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n"
+
+    def upgrade_then_stream(conn, head, rest):
+        conn.sendall(handshake)
+        try:
+            while True:
+                conn.sendall(b"A" * 4096)
+        except OSError:
+            pass  # the forwarder went away
+
+    proxy, _upstream, port = tls_forwarder(upgrade_then_stream)
+    with socket.create_connection(("127.0.0.1", port)) as client:
+        client.settimeout(5)
+        client.sendall(b"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
+        received = b""
+        while len(received) < len(handshake) + 100_000:  # the stream is flowing
+            received += client.recv(65536)
+        proxy.stop()
+        while chunk := client.recv(65536):  # ends: the forwarder closed the connection
+            received += chunk
+    assert received.startswith(handshake)
+    assert set(received[len(handshake) :]) == {ord("A")}
+
