#!/usr/bin/env python3
"""A stand-in for the `prized` CLI, for test.sh: just the `prized sandbox` commands spawn.sh and reap.sh use.

Each "sandbox" is a directory under $FAKE_PRIZED_ROOT whose home/ plays /home/prized. Commands run
there with a clean environment, as they would in a real sandbox: nothing from this machine's
environment gets in (except STUB_* settings for the stub worker). Every process a sandbox runs carries
FAKE_SANDBOX=<its directory> in its environment, so a pause can freeze them all (SIGSTOP) and a resume
or a command carry them on (SIGCONT), the way a real pause keeps memory and processes. Every call is
logged to calls.log. FAKE_QUOTA caps the sandboxes not deleted, as a workspace's disk quota does.
"""

import json
import os
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(os.environ["FAKE_PRIZED_ROOT"])
HERE = Path(__file__).resolve().parent


def log(argv):
    with open(ROOT / "calls.log", "a") as f:
        f.write(json.dumps({"t": time.time(), "argv": argv}) + "\n")


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")  # the API's form, with a fraction


def meta_path(sid):
    return ROOT / sid / "meta.json"


def load(sid):
    p = meta_path(sid)
    if not p.exists():
        print(f"prized: no sandbox {sid} in this workspace", file=sys.stderr)
        sys.exit(5)
    return json.loads(p.read_text())


def save(m):
    meta_path(m["id"]).write_text(json.dumps(m))


def home(sid):
    return ROOT / sid / "home"


def flags(args, repeatable=("label", "env")):
    out, rest, i = {}, [], 0
    while i < len(args):
        a = args[i]
        if a == "--":
            rest.extend(args[i:])
            break
        if a.startswith("--"):
            name = a[2:]
            if name in ("wait", "no-wait", "json"):
                out[name] = True
            else:
                i += 1
                if name in repeatable:
                    out.setdefault(name, []).append(args[i])
                else:
                    out[name] = args[i]
        else:
            rest.append(a)
        i += 1
    return out, rest


def seconds(d):
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    return float(d[:-1]) * units[d[-1]] if d[-1] in units else float(d)


def sandbox_pids(sid):
    """Every process the sandbox runs, found by the FAKE_SANDBOX marker in its environment."""
    mark = f"FAKE_SANDBOX={ROOT / sid}".encode()
    pids = []
    for p in Path("/proc").glob("[0-9]*"):
        try:
            if mark in p.joinpath("environ").read_bytes().split(b"\0"):
                pids.append(int(p.name))
        except OSError:
            pass
    return pids


def signal_all(pids, sig):
    for pid in pids:
        try:
            os.kill(pid, sig)
        except OSError:
            pass


def doc(m):
    keys = ("id", "state", "labels", "createdAt", "lastActiveAt")
    return {k: m.get(k) for k in keys} | {"autoDeleteMin": m.get("autoDeleteMin")}


def wake(m):
    """A command or file request to a paused sandbox resumes it first, as the real edge does."""
    if m["state"] in ("paused", "pausing"):
        signal_all(m.pop("frozen", []), signal.SIGCONT)
        m["state"] = "running"
        m["resumes"] = m.get("resumes", 0) + 1
    m["lastActiveAt"] = now()
    save(m)


def remote_path(sid, p):
    p = p[2:] if p.startswith("~/") else p
    return home(sid) / p if not p.startswith("/") else Path(p)


def main():
    argv = sys.argv[1:]
    log(argv)
    if argv[:1] != ["sandbox"]:
        sys.exit("fake-prized: only `prized sandbox` is faked")
    verb, args = argv[1], argv[2:]
    f, rest = flags(args)

    if verb == "ls":
        want = dict(kv.split("=", 1) for kv in f.get("label", []))
        boxes = []
        for p in sorted(ROOT.glob("sbx_*/meta.json")):
            m = json.loads(p.read_text())
            if m["state"] != "deleted" and all(m["labels"].get(k) == v for k, v in want.items()):
                boxes.append(doc(m))
        print(json.dumps({"sandboxes": list(reversed(boxes)), "ok": True}))  # newest first
    elif verb == "create":
        quota = os.environ.get("FAKE_QUOTA")
        live = [p for p in ROOT.glob("sbx_*/meta.json") if json.loads(p.read_text())["state"] != "deleted"]
        if quota and len(live) >= int(quota):
            print("prized: that would pass this workspace's disk limit of 500 GB", file=sys.stderr)
            print("  ↳ delete a sandbox first (a paused sandbox keeps its disk)", file=sys.stderr)
            sys.exit(6)
        n = len(list(ROOT.glob("sbx_*"))) + 1
        sid = f"sbx_{n:016x}"
        (home(sid) / "work").mkdir(parents=True)
        labels = dict(kv.split("=", 1) for kv in f.get("label", []))
        ad = f.get("auto-delete")
        save({"id": sid, "state": "running", "labels": labels, "flags": f, "createdAt": now(), "lastActiveAt": now(),
              "autoDeleteMin": int(seconds(ad) // 60) if ad and ad != "off" else None})
        print(sid)
    elif verb == "resume":
        m = load(rest[0])
        if m.get("resume_fails"):
            print(f"prized: sandbox {m['id']} can't be resumed (test)", file=sys.stderr)
            sys.exit(5)
        wake(m)
    elif verb == "pause":
        time.sleep(float(os.environ.get("FAKE_PAUSE_DELAY", "0")))  # a real pause can take seconds
        m = load(rest[0])
        pids = sandbox_pids(m["id"])  # a pause freezes everything in the sandbox: workers, servers
        signal_all(pids, signal.SIGSTOP)
        m["frozen"] = sorted(set(m.get("frozen", []) + pids))
        m["state"] = "paused"
        m["pauses"] = m.get("pauses", 0) + 1
        save(m)
    elif verb == "get":
        m = load(rest[0])
        if m["state"] == "deleted":
            print(f"prized: no sandbox {m['id']} in this workspace", file=sys.stderr)
            sys.exit(5)
        print(json.dumps({"sandbox": doc(m), "ok": True}))
    elif verb == "rm":
        for sid in rest:
            m = load(sid)
            pids = sandbox_pids(sid)  # deleting stops everything in it for good
            signal_all(pids, signal.SIGKILL)
            signal_all(pids, signal.SIGCONT)
            m["state"] = "deleted"
            m.pop("frozen", None)
            save(m)
    elif verb == "cp":
        src, dst = rest
        if src == "-":
            sid, p = dst.split(":", 1)
            wake(load(sid))
            target = remote_path(sid, p)
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(sys.stdin.buffer.read())
            os.chmod(target, 0o644)
        else:
            sid, p = src.split(":", 1)
            wake(load(sid))
            data = remote_path(sid, p).read_bytes()
            if dst == "-":
                sys.stdout.buffer.write(data)
            else:
                Path(dst).write_bytes(data)
    elif verb == "exec":
        sid, cmd = rest[0], " ".join(rest[2:])  # rest[1] is "--"
        m = load(sid)
        if m["state"] == "deleted":
            print(f"prized: no sandbox {sid} in this workspace", file=sys.stderr)
            sys.exit(5)
        fail = os.environ.get("FAKE_EXEC_FAIL")  # a file holding how many execs fail next, as in an outage
        if fail and os.path.exists(fail):
            n = int(open(fail).read().strip() or 0)
            if n > 0:
                open(fail, "w").write(str(n - 1))
                print("prized: sandbox edge unavailable (test)", file=sys.stderr)
                sys.exit(1)
        wake(m)
        env = {"HOME": str(home(sid)), "PATH": f"{HERE}/sandbox-bin:/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8",
               "FAKE_SANDBOX": str(ROOT / sid)}
        env.update({k: v for k, v in os.environ.items() if k.startswith("STUB_")})
        env.update(kv.split("=", 1) for kv in f.get("env", []))
        timeout = seconds(f.get("timeout", "5m"))
        proc = subprocess.Popen(["bash", "-c", cmd], cwd=home(sid) / "work", env=env, start_new_session=True)

        def stop(signum, frame):  # the caller went away: end its command too, so a test leaves nothing running
            os.killpg(proc.pid, signal.SIGKILL)
            sys.exit(128 + signum)

        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        try:
            sys.exit(proc.wait(timeout=timeout))
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, 9)
            sys.exit(124)
    else:
        sys.exit(f"fake-prized: sandbox {verb} is not faked")


if __name__ == "__main__":
    main()
