{
  "name": "@prized/pi",
  "version": "0.1.0",
  "description": "Prized Sandboxes for the Pi coding agent: Pi stays on your machine and runs its bash, read, write and edit tools in a Firecracker microVM that pauses between turns with its memory.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "prized",
    "sandbox",
    "microvm",
    "coding-agent"
  ],
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "author": "Prized <team@prized.dev>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/prized-dev/integrations/tree/main/pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prized-dev/integrations.git",
    "directory": "pi"
  },
  "bugs": {
    "url": "https://github.com/prized-dev/integrations/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/workspace.test.ts test/unit.test.ts test/pi.test.ts",
    "test:live": "tsx test/live.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@prized/sdk": "^0.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
