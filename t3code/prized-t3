# shellcheck disable=SC2016 # expands on the box
PREWARM_SCRIPT='
set -eu
V=$1 BASE=$2
DIR="$HOME/.t3/runtime/versions/$V"
ready() { [ -x "$DIR/t3" ] && [ "$(cat "$DIR/.install-complete" 2>/dev/null)" = "$V" ]; }
if ready; then echo "already installed"; exit 0; fi
mkdir -p "$HOME/.t3/runtime/versions"
LOCK="$HOME/.t3/runtime/versions/.$V.install.lock"
waited=0 unowned=0
while ! (set -C; printf "%s\n" "$$" > "$LOCK") 2>/dev/null; do
  owner=$(cat "$LOCK" 2>/dev/null || true)
  if [ -n "$owner" ]; then
    unowned=0
    if ! kill -0 "$owner" 2>/dev/null; then rm -rf "$LOCK"; continue; fi
  else
    unowned=$((unowned + 1))
    if [ "$unowned" -ge 5 ]; then rm -rf "$LOCK"; continue; fi
  fi
  [ "$waited" -lt 360 ] || { echo "another install of $V has held $LOCK for 6 minutes" >&2; exit 1; }
  sleep 1; waited=$((waited + 1))
done
STAGE=
trap "rm -rf \"\$LOCK\" \"\$STAGE\"" EXIT
if ready; then echo "already installed"; exit 0; fi
case "$(uname -s)" in Linux) P=linux ;; Darwin) P=darwin ;; *) echo "T3 Code has no server for $(uname -s)" >&2; exit 1 ;; esac
case "$(uname -m)" in x86_64 | amd64) A=x64 ;; arm64 | aarch64) A=arm64 ;; *) echo "T3 Code has no server for $(uname -m)" >&2; exit 1 ;; esac
ARCHIVE="t3-$V-$P-$A.tar.gz"
STAGE=$(mktemp -d "$HOME/.t3/runtime/versions/.staging-XXXXXX")
fetch() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL --connect-timeout 30 --max-time "$3" "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -q --timeout=30 --tries=1 "$1" -O "$2"
  else echo "the box needs curl or wget" >&2; exit 1
  fi
}
fetch "$BASE/v$V/SHA256SUMS" "$STAGE/SHA256SUMS" 30 || { echo "no T3 Code release $V at $BASE/v$V" >&2; exit 1; }
fetch "$BASE/v$V/$ARCHIVE" "$STAGE/$ARCHIVE" 240
expected=$(grep " \*\{0,1\}$ARCHIVE\$" "$STAGE/SHA256SUMS" | cut -d" " -f1)
if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$STAGE/$ARCHIVE" | cut -d" " -f1)
else actual=$(shasum -a 256 "$STAGE/$ARCHIVE" | cut -d" " -f1); fi
if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then echo "checksum mismatch for $ARCHIVE" >&2; exit 1; fi
tar -xzf "$STAGE/$ARCHIVE" -C "$STAGE" --strip-components=1
rm -f "$STAGE/$ARCHIVE" "$STAGE/SHA256SUMS"
"$STAGE/t3" --version >/dev/null 2>&1 || { echo "the t3 $V server does not run on this box" >&2; exit 1; }
printf "%s\n" "$V" > "$STAGE/.install-complete"
rm -rf "$DIR"
mv "$STAGE" "$DIR"
STAGE=
echo installed
'

# Allow the browser panel's Chrome sandbox (Ubuntu 24.04 blocks it) and install its fonts: T3
# Code's own `t3 browser setup`, run with the box's passwordless sudo.
# shellcheck disable=SC2016 # expands on the box
BROWSER_SCRIPT='
set -eu
T3="$HOME/.t3/runtime/versions/$1/t3"
if sudo -n true 2>/dev/null; then sudo -n "$T3" browser setup; else "$T3" browser setup; fi
'

# A fork boots with its source's ~/.t3, so T3 Code would take it for the same machine: its client
# files a host with a known environment id as another route to that machine. Stop T3 Code's
# servers here, then move aside what identifies this machine to T3 Code and to T3 Connect (into
# ~/.t3/identity-reset-<time>, 0700); projects, threads, settings and your own saved secrets stay.
# T3 Code makes a new identity on its next start.
# shellcheck disable=SC2016 # expands on the box
RESET_SCRIPT='
set -eu
T3="$HOME/.t3" U="$HOME/.t3/userdata"
[ -d "$T3" ] || { echo "nothing to reset: no ~/.t3 on this box"; exit 0; }
# A T3 Code server: its runtime binary, or the launcher script that execs it, running "serve".
is_t3_server() {
  [ -n "$1" ] && [ -r "/proc/$1/cmdline" ] || return 1
  tr "\000" "\n" < "/proc/$1/cmdline" | awk -v rt="$T3/runtime/versions/" -v sl="$T3/ssh-launch/" "
    function runtime(a) { return index(a, rt) == 1 && substr(a, length(rt) + 1) ~ /^[^\\/]+\\/t3\$/ }
    function launcher(a) { return index(a, sl) == 1 && substr(a, length(sl) + 1) ~ /^[^\\/]+\\/run-t3\\.sh\$/ }
    NR == 1 { a0 = \$0 } NR == 2 { a1 = \$0 } NR == 3 { a2 = \$0 }
    END {
      shell = (a0 ~ /(^|\\/)(sh|dash|bash)\$/)
      exit !((runtime(a0) && a1 == \"serve\") || (shell && (runtime(a1) || launcher(a1)) && a2 == \"serve\"))
    }"
}
stop_pid() {
  is_t3_server "$1" || return 0
  kill "$1" 2>/dev/null || true
  n=0; while kill -0 "$1" 2>/dev/null && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
  if kill -0 "$1" 2>/dev/null; then echo "T3 Code server $1 did not stop" >&2; exit 1; fi
  echo "stopped T3 Code server $1"
}
service=no
if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet t3code.service 2>/dev/null; then
  systemctl --user stop t3code.service && service=yes && echo "stopped t3code.service"
fi
for f in "$T3"/ssh-launch/*/pid; do [ -f "$f" ] && stop_pid "$(cat "$f" 2>/dev/null || true)"; done
stop_pid "$(sed -n "s/.*\"pid\":\([0-9]*\).*/\1/p" "$U/server-runtime.json" 2>/dev/null | head -n 1)"
old=$(cat "$U/environment-id" 2>/dev/null || true)
B="$T3/identity-reset-$(date +%Y%m%d-%H%M%S)"
umask 077
moved=0
for f in "$U/environment-id" "$U/environment-id.recovery" "$U/server-runtime.json" "$U/anonymous-id" \
  "$T3/usage-host-id" "$U/secrets/server-signing-key.bin" "$U/secrets/guest-share-signing-key.bin" \
  "$U/secrets/mcp-oauth-signing-key.bin" "$U/secrets/asset-access-signing-key.bin" "$U"/secrets/cloud-*.bin \
  "$T3/ssh-launch"; do
  [ -e "$f" ] || continue
  rel=${f#"$T3"/}
  mkdir -p "$B/$(dirname "$rel")"
  mv "$f" "$B/$rel"
  moved=$((moved + 1))
done
[ "$service" = no ] || { systemctl --user start t3code.service && echo "started t3code.service"; }
[ "$moved" = 0 ] || echo "kept a copy of the old files in ~/${B#"$HOME"/}"
echo "reset ${old:--}"
'

# --- commands ------------------------------------------------------------------------------------

# report BOX: run the checks on BOX and print what T3 Code will find; sets AGENTS_MISSING, SIGNED_OUT.
report() {
  rp_out=$(remote "$1" "$CHECK_SCRIPT") || die "could not run the checks on $1 over ssh"
  rp() { printf '%s\n' "$rp_out" | sed -n "s/^$1=//p" | head -n 1; }
  say "  system:       $(rp os)"
  rp_missing=
  [ -n "$(rp fetch)" ] || rp_missing="$rp_missing curl"
  [ -n "$(rp tar)" ] || rp_missing="$rp_missing tar"
  [ -n "$(rp sha)" ] || rp_missing="$rp_missing sha256sum"
  if [ -n "$rp_missing" ]; then say "  missing:     $rp_missing (T3 Code's server install needs them)"; fi
  AGENTS_MISSING='' SIGNED_OUT=''
  for rp_a in claude codex opencode; do
    rp_p=$(rp "agent_$rp_a")
    if [ "$rp_p" = - ]; then
      [ "$rp_a" = opencode ] || AGENTS_MISSING="$AGENTS_MISSING $rp_a"
    else
      rp_s=
      case $rp_a in
        claude | codex)
          if [ -n "$(rp "signed_in_$rp_a")" ]; then rp_s=", signed in"; else rp_s=", no sign-in found"; SIGNED_OUT="$SIGNED_OUT $rp_a"; fi
          ;;
      esac
      printf '  %-14s%s\n' "$rp_a:" "$rp_p$rp_s"
    fi
  done
  [ -z "$AGENTS_MISSING" ] || say "  not found:    $AGENTS_MISSING (on a non-interactive login shell's PATH, where T3 Code looks)"
  rp_rt=$(printf '%s\n' "$rp_out" | sed -n 's/^runtime=//p' | tr '\n' ' ' | sed 's/ *$//')
  say "  T3 server:    ${rp_rt:-not installed yet}"
  rp_id=$(rp environment_id)
  if [ "$rp_id" = - ]; then say "  T3 identity:  none yet (made on the first start)"; else say "  T3 identity:  $rp_id"; fi
  if [ -n "$(rp userns_restricted)" ] && [ -z "$(rp browser_profile)" ]; then
    say "  browser:      blocked until t3 browser setup runs (Ubuntu 24.04 restricts Chrome's sandbox)"
  elif [ -n "$(rp browser_profile)" ]; then
    say "  browser:      Chrome's sandbox allowed"
  fi
}

cmd_check() {
  ck_box=${1:-}
  need_prized
  if [ -z "$ck_box" ]; then default_box; ck_box=$BOX_NAME; fi
  valid_box "$ck_box" || die "not a box name: $ck_box"
  box_state "$ck_box"
  ck_state=$STATE
  say "$ck_box ($ck_state)"
  [ "$ck_state" = running ] || { say "  paused: prized-t3 up $ck_box wakes it and checks the rest"; return 0; }
  if ! box_ssh "$ck_box" true </dev/null 2>/dev/null; then
    say "  ssh $ck_box:   doesn't connect (prized-t3 up $ck_box adds it to your SSH config)"
    return 0
  fi
  say "  ssh $ck_box:   ok (T3 Code lists it under Add environment > SSH)"
  report "$ck_box"
}

cmd_reset() {
  rs_box='' rs_yes=''
  for rs_arg in "$@"; do
    case $rs_arg in
      -y | --yes) rs_yes=yes ;;
      -*) die "unknown option $rs_arg (prized-t3 --help)" ;;
      *) [ -z "$rs_box" ] || die "one box at a time"; rs_box=$rs_arg ;;
    esac
  done
  valid_box "$rs_box" || die "usage: prized-t3 reset-identity BOX [--yes]"
  need_prized
  if [ -z "$rs_yes" ]; then
    interactive || die "reset-identity stops T3 Code's server on $rs_box and unlinks it from T3 Connect: pass --yes to go ahead"
    printf 'This stops T3 Code on %s and gives it a new identity: devices paired with it pair again, and its\nT3 Connect link is removed. Type %s to go ahead: ' "$rs_box" "$rs_box"
    read -r rs_answer || rs_answer=''
    [ "$rs_answer" = "$rs_box" ] || die "nothing changed"
  fi
  wake "$rs_box"
  ensure_alias "$rs_box"
  rs_out=$(remote "$rs_box" "$RESET_SCRIPT") || die "could not reset T3 Code's identity on $rs_box"
  printf '%s\n' "$rs_out" | sed -n '/^reset /!s/^/  /p'
  rs_old=$(printf '%s\n' "$rs_out" | sed -n 's/^reset //p')
  case $rs_old in
    '') ;;
    -) say "  T3 identity:  none yet; T3 Code makes one when it first starts there" ;;
    *) say "  T3 identity:  $rs_old moved aside; T3 Code makes a new one when it next starts there" ;;
  esac
}

cmd_up() {
  up_box='' up_new='' up_tier='' up_version='' up_pause='' up_browser=yes up_open=yes
  while [ $# -gt 0 ]; do
    case $1 in
      --new) up_new=yes ;;
      --tier | --size) [ $# -ge 2 ] || die "$1 needs a value"; up_tier=$2; shift ;;
      --t3-version) [ $# -ge 2 ] || die "$1 needs a value"; up_version=$2; shift ;;
      --auto-pause) [ $# -ge 2 ] || die "$1 needs a value"; up_pause=$2; shift ;;
      --no-browser-setup) up_browser= ;;
      --no-open) up_open= ;;
      -h | --help) usage; exit 0 ;;
      -*) die "unknown option $1 (prized-t3 --help)" ;;
      *) [ -z "$up_box" ] || die "one box at a time"; up_box=$1 ;;
    esac
    shift
  done
  [ -z "$up_version" ] || valid_version "$up_version" || die "--t3-version takes one exact version, such as 0.1.7"
  [ -z "$up_box" ] || valid_box "$up_box" || die "not a box name: $up_box"
  [ -z "$up_tier" ] || [ -n "$up_new" ] || die "--tier goes with --new (prized resize changes an existing box)"
  [ -z "$up_pause" ] || valid_pause "$up_pause" || die "--auto-pause takes a window such as 45m, 2h or 7d, or off"
  need_prized

  if [ -n "$up_new" ]; then
    say "Creating a box${up_box:+ named $up_box}"
    up_json=$("$PRIZED" box new ${up_box:+"$up_box"} ${up_tier:+--tier "$up_tier"} --wait --json) || die "prized box new failed"
    up_box=$(printf '%s\n' "$up_json" | json_str hostname)
    [ -n "$up_box" ] || die "prized box new did not name the new box"
  fi
  if [ -z "$up_box" ]; then default_box; up_box=$BOX_NAME; fi
  say "Getting $up_box ready for T3 Code"
  wake "$up_box"
  ensure_alias "$up_box"
  say "  ssh $up_box:   ok"
  if [ -n "$up_pause" ]; then
    "$PRIZED" box auto-pause "$up_box" "$up_pause" >/dev/null || die "prized box auto-pause $up_box $up_pause failed"
    say "  auto-pause:   $up_pause"
  fi

  T3_APP=''
  if [ -z "$up_version" ]; then
    t3_version
    up_version=$T3_VER
    if [ -n "$up_version" ]; then
      say "  T3 Code here: $up_version${T3_APP:+ ($T3_APP)}"
    else
      up_version=$(latest_t3_version) || up_version=
      [ -z "$up_version" ] || say "  T3 Code here: not found; installing the latest release, $up_version (--t3-version picks another)"
    fi
  fi
  if [ -n "$up_version" ] && valid_version "$up_version"; then
    up_out=$(remote "$up_box" "$PREWARM_SCRIPT" "$up_version" "$RELEASE_BASE" 2>&1) ||
      die "installing T3 Code's $up_version server on $up_box failed: $(printf '%s' "$up_out" | tail -n 3)"
    say "  T3 server:    $up_version $(printf '%s' "$up_out" | tail -n 1) in ~/.t3/runtime"
    if [ -n "$up_browser" ]; then
      if up_out=$(remote "$up_box" "$BROWSER_SCRIPT" "$up_version" 2>&1); then
        say "  browser:      $(printf '%s' "$up_out" | grep -v '^[[:space:]]*$' | tail -n 1)"
      else
        say "  browser:      t3 browser setup did not finish; run it on the box: $(printf '%s' "$up_out" | tail -n 1)"
      fi
    fi
  else
    say "  T3 server:    T3 Code installs it on the first connect (no version to install found)"
  fi

  report "$up_box"
  if [ -n "$SIGNED_OUT" ]; then
    if ask "Copy your$SIGNED_OUT sign-in and your GitHub login (gh) from this computer to $up_box (prized agents handoff)?"; then
      # shellcheck disable=SC2086 # agent names
      "$PRIZED" --box "$up_box" agents handoff $SIGNED_OUT --gh || warn "prized agents handoff did not finish"
    else
      say "  sign in:      prized --box $up_box agents handoff$SIGNED_OUT --gh"
    fi
  fi

  say ""
  say "$up_box is ready. In T3 Code: Settings > Environments > Add environment > SSH, and pick"
  say "$up_box (T3 Code lists it from your SSH config). Then Add project > $up_box > Local folder."
  if [ -n "$up_open" ] && [ "$(uname -s)" = Darwin ] && command -v open >/dev/null 2>&1; then
    if [ -n "$T3_APP" ]; then open "$T3_APP" 2>/dev/null || true
    else open -a "T3 Code (Beta)" 2>/dev/null || open -a "T3 Code" 2>/dev/null || say "T3 Code isn't installed here: https://t3.codes"; fi
  fi
}

cmd_fork() {
  fk_src='' fk_name='' fk_tier='' fk_version='' fk_pause='' fk_nobrowser='' fk_noopen=''
  while [ $# -gt 0 ]; do
    case $1 in
      --name) [ $# -ge 2 ] || die "$1 needs a value"; fk_name=$2; shift ;;
      --tier | --size) [ $# -ge 2 ] || die "$1 needs a value"; fk_tier=$2; shift ;;
      --t3-version) [ $# -ge 2 ] || die "$1 needs a value"; fk_version=$2; shift ;;
      --auto-pause) [ $# -ge 2 ] || die "$1 needs a value"; fk_pause=$2; shift ;;
      --no-browser-setup) fk_nobrowser=yes ;;
      --no-open) fk_noopen=yes ;;
      -h | --help) usage; exit 0 ;;
      -*) die "unknown option $1 (prized-t3 --help)" ;;
      *) [ -z "$fk_src" ] || die "one box at a time"; fk_src=$1 ;;
    esac
    shift
  done
  # Everything is checked before the fork: a fork takes minutes and makes a billed box.
  valid_box "$fk_src" || die "usage: prized-t3 fork BOX [--name NEW]"
  [ -z "$fk_name" ] || valid_box "$fk_name" || die "not a box name: $fk_name"
  [ "$fk_name" != "$fk_src" ] || die "the fork needs a name of its own"
  [ -z "$fk_version" ] || valid_version "$fk_version" || die "--t3-version takes one exact version, such as 0.1.7"
  [ -z "$fk_pause" ] || valid_pause "$fk_pause" || die "--auto-pause takes a window such as 45m, 2h or 7d, or off"
  need_prized
  box_state "$fk_src"
  say "Forking $fk_src (its disk now: repos, sign-ins, T3 Code projects and threads)"
  fk_json=$("$PRIZED" fork "$fk_src" ${fk_name:+--name "$fk_name"} ${fk_tier:+--tier "$fk_tier"} --wait --json) ||
    die "prized fork $fk_src failed"
  fk_new=$(printf '%s\n' "$fk_json" | json_str hostname)
  [ -n "$fk_new" ] || fk_new=$fk_name
  [ -n "$fk_new" ] || die "prized fork did not name the new box"
  valid_box "$fk_new" || die "prized fork named the new box $fk_new, which is not a box name"
  # The reset below changes the box it is given: never the source.
  [ "$fk_new" != "$fk_src" ] || die "prized fork answered with the source box's name; nothing reset"
  say "  new box:      $fk_new"
  cmd_reset "$fk_new" --yes
  cmd_up "$fk_new" ${fk_version:+--t3-version "$fk_version"} ${fk_pause:+--auto-pause "$fk_pause"} \
    ${fk_nobrowser:+--no-browser-setup} ${fk_noopen:+--no-open}
}

case ${1:-} in
  up) shift; cmd_up "$@" ;;
  fork) shift; cmd_fork "$@" ;;
  check) shift; cmd_check "$@" ;;
  reset-identity) shift; cmd_reset "$@" ;;
  -V | --version) say "prized-t3 $PRIZED_T3_VERSION" ;;
  '' | -h | --help | help) usage ;;
  *) warn "unknown command $1"; usage >&2; exit 2 ;;
esac
