#!/bin/sh
# prized-t3: make a Prized box a T3 Code environment, or fork one into another.
#
#   prized-t3 up [BOX]           get BOX (default: your default box) ready for T3 Code's SSH environments
#   prized-t3 fork BOX [--name NEW]
#                                copy BOX into a new box that T3 Code sees as a machine of its own
#   prized-t3 check [BOX]        what T3 Code will find on BOX, changing nothing
#   prized-t3 reset-identity BOX give BOX a new T3 Code identity (after a `prized fork` made by hand)
#
# Its box-side install (PREWARM_SCRIPT) is adapted from T3 Code's SSH runner; see the MIT notice there.
#
# T3 Code (https://github.com/pingdotgg/t3code, MIT) adds a remote machine as an SSH host: its
# desktop app lists the hosts in ~/.ssh/config, installs its server under ~/.t3/runtime there and
# tunnels to it. This script does the box's side of that before you click: the box is awake, its
# alias is in your SSH config, the server for your app's version is installed, the browser panel's
# sandbox is allowed, and the agent CLIs are where T3 Code looks. It never reads or sends a key:
# `prized` and `ssh` use your own sign-in. https://github.com/prized-dev/integrations/tree/main/t3code
set -eu

PRIZED_T3_VERSION=0.1.0
PRIZED=${PRIZED_T3_PRIZED:-prized}
SSH=${PRIZED_T3_SSH:-ssh}
# Where T3 Code's desktop app downloads its server from (packages/shared/src/cliRelease.ts).
RELEASE_BASE=https://github.com/pingdotgg/t3code/releases/download
GUIDE='https://prized.dev/docs/t3-code?via=t3code'

say() { printf '%s\n' "$*"; }
warn() { printf 'prized-t3: %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }
interactive() { [ -t 0 ] && [ -t 1 ] && [ -z "${PRIZED_T3_NO_PROMPT:-}" ]; }
ask() { # ask QUESTION: yes only for an answer starting with y; no when not interactive
  interactive || return 1
  printf '%s [y/N] ' "$1"
  read -r ask_answer || return 1
  case $ask_answer in [Yy]*) return 0 ;; *) return 1 ;; esac
}

usage() {
  cat <<EOF
prized-t3 $PRIZED_T3_VERSION: make a Prized box a T3 Code environment

  prized-t3 up [BOX] [options]       get BOX (default: your default box) ready for T3 Code
      --new                          create BOX first (a fruit name when BOX is left out)
      --tier TIER                    size for --new (nano, micro, lite, flow, pro, max, ...)
      --t3-version V                 T3 Code server to install (default: your desktop app's)
      --auto-pause WINDOW|off        set the box's idle auto-pause (45m, 2h, off)
      --no-browser-setup             leave the box's AppArmor and fonts alone
      --no-open                      don't open T3 Code afterwards (macOS)
  prized-t3 fork BOX [--name NEW] [--tier TIER] [up options]
                                     copy BOX's disk into a new box with its own T3 Code identity
  prized-t3 check [BOX]              what T3 Code will find on BOX, changing nothing
  prized-t3 reset-identity BOX [--yes]
                                     give BOX a new T3 Code identity (stops T3 Code's server there;
                                     the old files move to ~/.t3/identity-reset-<time>)

Then in T3 Code: Settings > Environments > Add environment > SSH, and pick the box.
Guide: $GUIDE
EOF
}

# --- small helpers -----------------------------------------------------------------------------

# json_str KEY: the value of the first "KEY":"value" in compact JSON on stdin (prized prints compact JSON).
json_str() { grep -o "\"$1\":\"[^\"]*\"" | head -n 1 | cut -d '"' -f 4; }

valid_box() { # box names: lowercase letters, digits and hyphens, as prized allows
  case $1 in '' | -* | *[!a-z0-9-]*) return 1 ;; esac
}
valid_version() { # one exact version, as T3 Code requires for a runtime directory name
  [ "$(printf '%s' "$1" | wc -l)" -eq 0 ] || return 1
  printf '%s\n' "$1" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'
}

valid_pause() { # an idle window prized takes (45m, 2h, 90, 7d) or off
  case $1 in off) return 0 ;; '' | *[!0-9mhd]*) return 1 ;; esac
  printf '%s\n' "$1" | grep -Eq '^[0-9]+[mhd]?$'
}

box_ssh() { # box_ssh BOX CMD...: plain ssh, as T3 Code runs it, never asking for a password
  bs_box=$1; shift
  "$SSH" -o BatchMode=yes -o ConnectTimeout=20 -- "$bs_box" "$@"
}
# remote BOX SCRIPT [ARG...]: run SCRIPT in a login shell on BOX (T3 Code launches its server the
# same way), with ARGs single-quoted for the remote shell.
remote() {
  r_box=$1 r_script=$2; shift 2
  r_args=
  for r_arg in "$@"; do
    # shellcheck disable=SC2089 # quotes for the remote shell, on purpose
    r_args="$r_args '$(printf '%s' "$r_arg" | sed "s/'/'\\\\''/g")'"
  done
  # One string: ssh hands it to the box's shell as is, so nothing here splits or globs the args.
  printf '%s\n' "$r_script" | box_ssh "$r_box" "sh -l -s --$r_args"
}

need_prized() {
  command -v "$PRIZED" >/dev/null 2>&1 || die "the prized CLI isn't installed: curl -fsSL https://prized.dev/install.sh | sh, then prized login"
}
# prized_info [BOX]: sets INFO to `prized info --json` for BOX (the default box without one), or dies
# with prized's own message (signed out, offline, no such box).
prized_info() {
  if INFO=$("$PRIZED" info ${1:+"$1"} --json 2>&1); then return 0; fi
  pi_msg=$(printf '%s\n' "$INFO" | json_str message)
  [ -n "$pi_msg" ] || pi_msg=$(printf '%s\n' "$INFO" | tail -n 1)
  if [ -n "${1:-}" ]; then die "prized info $1: ${pi_msg:-failed}"; fi
  die "no default box (${pi_msg:-prized info failed}): name one, or create one with prized-t3 up --new"
}
default_box() { # sets BOX_NAME to the default box
  prized_info
  BOX_NAME=$(printf '%s\n' "$INFO" | json_str hostname)
  [ -n "$BOX_NAME" ] || die "prized info names no default box: name one, or create one with prized-t3 up --new"
}
box_state() { # sets STATE for BOX
  prized_info "$1"
  STATE=$(printf '%s\n' "$INFO" | json_str observedState)
  [ -n "$STATE" ] || die "prized info $1 gave no state"
}

wake() { # wake BOX: resume it unless it is running; T3 Code's 10 s ssh timeout won't wait for a wake
  box_state "$1"
  w_state=$STATE
  case $w_state in
    running) ;;
    *)
      say "  $1 is $w_state: resuming it"
      "$PRIZED" box resume "$1" --wait >/dev/null || die "prized box resume $1 failed"
      ;;
  esac
}

ensure_alias() { # ensure_alias BOX: plain `ssh BOX` works, adding BOX to the SSH config if needed
  if box_ssh "$1" true </dev/null 2>/dev/null; then return 0; fi
  say "  adding $1 to your SSH config (prized init --box $1)"
  "$PRIZED" init --box "$1" --non-interactive --no-daemon </dev/null >/dev/null 2>&1 || true
  box_ssh "$1" true </dev/null 2>/dev/null && return 0
  die "plain ssh does not reach $1. T3 Code needs that: run prized init --box $1, then prized-t3 up $1 again"
}

# t3_version: sets T3_VER to the T3 Code desktop app's version here (its server must match it
# exactly) and T3_APP to the app it found, else leaves them empty.
t3_version() {
  T3_VER='' T3_APP=''
  for tv_app in "/Applications/T3 Code (Beta).app" "/Applications/T3 Code (Nightly).app" "/Applications/T3 Code.app" \
    "$HOME/Applications/T3 Code (Beta).app" "$HOME/Applications/T3 Code (Nightly).app" "$HOME/Applications/T3 Code.app"; do
    if [ -f "$tv_app/Contents/Info.plist" ] && command -v defaults >/dev/null 2>&1; then
      tv=$(defaults read "$tv_app/Contents/Info" CFBundleShortVersionString 2>/dev/null) || tv=
      if [ -n "$tv" ]; then T3_APP=$tv_app T3_VER=$tv; return 0; fi
    fi
  done
  if command -v t3 >/dev/null 2>&1; then
    T3_VER=$(t3 --version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?' | head -n 1) || T3_VER=''
  fi
}

latest_t3_version() { # the newest stable T3 Code release, from GitHub's latest-release redirect
  command -v curl >/dev/null 2>&1 || return 0
  curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/pingdotgg/t3code/releases/latest 2>/dev/null |
    sed -n 's#.*/tag/v\([^/]*\)$#\1#p'
}

# --- what runs on the box ----------------------------------------------------------------------

# Read-only: what T3 Code's SSH launcher and its providers will find. One key=value per line.
# shellcheck disable=SC2016 # expands on the box
CHECK_SCRIPT='
printf "os=%s %s\n" "$(uname -s)" "$(uname -m)"
for c in curl wget; do command -v $c >/dev/null 2>&1 && { echo "fetch=$c"; break; }; done
command -v tar >/dev/null 2>&1 && echo tar=yes
for c in sha256sum shasum; do command -v $c >/dev/null 2>&1 && { echo "sha=$c"; break; }; done
for a in claude codex opencode; do p=$(command -v $a 2>/dev/null || true); echo "agent_$a=${p:--}"; done
[ -s "$HOME/.claude/.credentials.json" ] && echo signed_in_claude=yes
[ -s "$HOME/.codex/auth.json" ] && echo signed_in_codex=yes
for d in "$HOME"/.t3/runtime/versions/*/; do
  [ -d "$d" ] || continue; v=$(basename "$d")
  [ -x "$d/t3" ] && [ "$(cat "$d/.install-complete" 2>/dev/null)" = "$v" ] && echo "runtime=$v"
done
id=$(cat "$HOME/.t3/userdata/environment-id" 2>/dev/null || true); echo "environment_id=${id:--}"
[ -f /etc/apparmor.d/t3-chrome-headless-shell ] && echo browser_profile=yes
[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null || echo 0)" = 1 ] && echo userns_restricted=yes
sudo -n true 2>/dev/null && echo sudo=yes
true
'

